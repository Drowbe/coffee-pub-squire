{{!--
  Squire contribution for Blacksmith's shared quantity/split control.

  Required:
    inputName, max
  Optional:
    value (default 1), min (default 1), giveLabel, keepLabel, amountLabel
--}}
<div class="blacksmith-quantity-split"
     data-quantity-split
     data-min="{{#if min}}{{min}}{{else}}1{{/if}}"
     data-max="{{max}}">
    <output class="blacksmith-quantity-split-value"
            data-quantity-give
            for="{{inputName}}">{{#if value}}{{value}}{{else}}1{{/if}}</output>
    <input type="range"
           id="{{inputName}}"
           name="{{inputName}}"
           value="{{#if value}}{{value}}{{else}}1{{/if}}"
           min="{{#if min}}{{min}}{{else}}1{{/if}}"
           max="{{max}}"
           step="1"
           aria-label="{{#if amountLabel}}{{amountLabel}}{{else}}Transfer amount{{/if}}">
    <output class="blacksmith-quantity-split-value"
            data-quantity-keep
            for="{{inputName}}">0</output>

    <span class="blacksmith-quantity-split-caption" data-quantity-give-label>
        {{#if giveLabel}}{{giveLabel}}{{else}}Give{{/if}}
    </span>
    <span class="blacksmith-quantity-split-caption blacksmith-quantity-split-caption-amount">
        {{#if amountLabel}}{{amountLabel}}{{else}}Transfer Amount{{/if}}
    </span>
    <span class="blacksmith-quantity-split-caption" data-quantity-keep-label>
        {{#if keepLabel}}{{keepLabel}}{{else}}Keep{{/if}}
    </span>
</div>
