{
  "note": {
    "size": {
      "w": 60,
      "h": 60
    },
    "shape": "circle",
    "style": {
      "fill": "rgba(205, 200, 117, 0.9)",
      "stroke": "#ffffff",
      "strokeWidth": 2,
      "iconColor": "#555555"
    },
    "dropShadow": true,
    "textLayout": "under",
    "textDisplay": "always",
    "textColor": "#ffffff",
    "textSize": 12,
    "textMaxLength": 0,
    "textMaxWidth": 0,
    "textScaleWithPin": true,
    "lockProportions": true,
    "allowDuplicatePins": false,
    "eventAnimations": {
      "hover": {
        "animation": "ripple",
        "sound": null
      },
      "click": {
        "animation": "scale-small",
        "sound": null
      },
      "doubleClick": {
        "animation": null,
        "sound": null
      },
      "add": {
        "animation": null,
        "sound": null
      },
      "delete": {
        "animation": "fade",
        "sound": null
      }
    },
    "config": {
      "blacksmithAccess": "private",
      "blacksmithVisibility": "visible"
    }
  }
}
