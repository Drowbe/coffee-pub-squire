{{#*inline "weapon-item"}}
<div draggable="true" class="panel-item {{#if system.equipped}}prepared{{/if}}" data-item-id="{{id}}" data-item-type="weapon" data-category-id="{{categoryId}}" data-action-types="{{actionTypes}}" data-equip-state="{{#if system.equipped}}equipped{{else}}unequipped{{/if}}">
    <div class="panel-item-row">
        <div class="panel-item-image-container">
            <img draggable="false" class="panel-item-image" src="{{img}}" alt="{{name}}"/>
            <i class="fa-solid fa-dice-d20 panel-item-roll-overlay"></i>
        </div>
        <div class="panel-item-name">
            <span class="panel-item-label">{{name}}</span>
            {{#if isNew}}<span class="new-tag">NEW</span>{{/if}}
            <span class="panel-item-context">
                {{> action-badge actionType=actionType}}
                {{#if canEditQuantity}}
                <span class="panel-item-badge context-count editable" data-quantity-edit title="Quantity — click to edit, 0 removes the item">x{{system.quantity}}</span>
                {{/if}}
            </span>
        </div>
        <div class="tray-buttons">
            {{#if statblockIssue}}
            <i class="fa-solid fa-triangle-exclamation statblock-warning {{#unless statblockIssue.canFix}}no-fix{{/unless}}" data-tooltip="{{{statblockIssue.tooltip}}}"></i>
            {{/if}}
            {{#if isLightSource}}
            <i class="fa-solid fa-lightbulb {{#unless isLightActive}}faded{{/unless}} {{#if isLightActive}}light-active{{/if}}" title="Toggle Light" data-item-id="{{id}}"></i>
            {{/if}}
            {{#if container}}
            <i class="fa-solid fa-sack item-container-open" data-container-id="{{container.id}}" data-tooltip="Stored in <strong>{{container.name}}</strong><br><em>Click to open</em>"></i>
            {{/if}}
            <i class="fa-solid fa-shield-alt {{#unless system.equipped}}faded{{/unless}}" title="Toggle Equipped"></i>
            <i class="fa-solid fa-heart {{#unless isFavorite}}faded{{/unless}}" title="Toggle Favorite"></i>
            <i class="fa-solid fa-share weapons-send-item" title="Send Weapon" data-item-id="{{id}}"></i>
            <i class="fa-solid fa-feather"></i>
        </div>
    </div>
</div>
{{/inline}}

<div class="weapons-panel">
<div class="section-header">
    <div class="header-left">
        <i class="fa-solid fa-swords"></i> Weapons
    </div>
    <div class="header-right">
        {{#if (lookup weaponsByType "simple-melee")}}<i class="fa-solid fa-hand-fist weapons-category-filter active" data-filter-id="category-weapon-simple-melee" title="Toggle Simple Melee"></i>{{/if}}
        {{#if (lookup weaponsByType "martial-melee")}}<i class="fa-solid fa-sword weapons-category-filter active" data-filter-id="category-weapon-martial-melee" title="Toggle Martial Melee"></i>{{/if}}
        {{#if (lookup weaponsByType "simple-ranged")}}<i class="fa-solid fa-bow-arrow weapons-category-filter active" data-filter-id="category-weapon-simple-ranged" title="Toggle Simple Ranged"></i>{{/if}}
        {{#if (lookup weaponsByType "martial-ranged")}}<i class="fa-solid fa-crosshairs weapons-category-filter active" data-filter-id="category-weapon-martial-ranged" title="Toggle Martial Ranged"></i>{{/if}}
        {{#if (lookup weaponsByType "natural")}}<i class="fa-solid fa-paw weapons-category-filter active" data-filter-id="category-weapon-natural" title="Toggle Natural Weapons"></i>{{/if}}
    </div>
</div>

    <div class="weapons-list">
        {{#if weapons}}
            {{!-- Simple Melee Weapons --}}
            {{#if (lookup weaponsByType "simple-melee")}}
            <div class="category-header" data-category-id="category-weapon-simple-melee">Simple Melee Weapons</div>
            {{#each (lookup weaponsByType "simple-melee") as |weapon|}}
            {{> weapon-item 
                id=weapon.id 
                img=weapon.img 
                name=weapon.name 
                actionType=weapon.actionType 
                system=weapon.system 
                canEditQuantity=weapon.canEditQuantity 
                statblockIssue=weapon.statblockIssue 
                isFavorite=weapon.isFavorite 
                isLightSource=weapon.isLightSource
                isLightActive=weapon.isLightActive
                categoryId="category-weapon-simple-melee"}}
            {{/each}}
            {{/if}}

            {{!-- Martial Melee Weapons --}}
            {{#if (lookup weaponsByType "martial-melee")}}
            <div class="category-header" data-category-id="category-weapon-martial-melee">Martial Melee Weapons</div>
            {{#each (lookup weaponsByType "martial-melee") as |weapon|}}
            {{> weapon-item 
                id=weapon.id 
                img=weapon.img 
                name=weapon.name 
                actionType=weapon.actionType 
                system=weapon.system 
                canEditQuantity=weapon.canEditQuantity 
                statblockIssue=weapon.statblockIssue 
                isFavorite=weapon.isFavorite 
                isLightSource=weapon.isLightSource
                isLightActive=weapon.isLightActive
                categoryId="category-weapon-martial-melee"}}
            {{/each}}
            {{/if}}

            {{!-- Simple Ranged Weapons --}}
            {{#if (lookup weaponsByType "simple-ranged")}}
            <div class="category-header" data-category-id="category-weapon-simple-ranged">Simple Ranged Weapons</div>
            {{#each (lookup weaponsByType "simple-ranged") as |weapon|}}
            {{> weapon-item 
                id=weapon.id 
                img=weapon.img 
                name=weapon.name 
                actionType=weapon.actionType 
                system=weapon.system 
                canEditQuantity=weapon.canEditQuantity 
                statblockIssue=weapon.statblockIssue 
                isFavorite=weapon.isFavorite 
                isLightSource=weapon.isLightSource
                isLightActive=weapon.isLightActive
                categoryId="category-weapon-simple-ranged"}}
            {{/each}}
            {{/if}}

            {{!-- Martial Ranged Weapons --}}
            {{#if (lookup weaponsByType "martial-ranged")}}
            <div class="category-header" data-category-id="category-weapon-martial-ranged">Martial Ranged Weapons</div>
            {{#each (lookup weaponsByType "martial-ranged") as |weapon|}}
            {{> weapon-item 
                id=weapon.id 
                img=weapon.img 
                name=weapon.name 
                actionType=weapon.actionType 
                system=weapon.system 
                canEditQuantity=weapon.canEditQuantity 
                statblockIssue=weapon.statblockIssue 
                isFavorite=weapon.isFavorite 
                isLightSource=weapon.isLightSource
                isLightActive=weapon.isLightActive
                categoryId="category-weapon-martial-ranged"}}
            {{/each}}
            {{/if}}

            {{!-- Natural Weapons --}}
            {{#if (lookup weaponsByType "natural")}}
            <div class="category-header" data-category-id="category-weapon-natural">Natural Weapons</div>
            {{#each (lookup weaponsByType "natural") as |weapon|}}
            {{> weapon-item 
                id=weapon.id 
                img=weapon.img 
                name=weapon.name 
                actionType=weapon.actionType 
                system=weapon.system 
                canEditQuantity=weapon.canEditQuantity 
                statblockIssue=weapon.statblockIssue 
                isFavorite=weapon.isFavorite 
                isLightSource=weapon.isLightSource
                isLightActive=weapon.isLightActive
                categoryId="category-weapon-natural"}}
            {{/each}}
            {{/if}}

            <div class="tray-title-small no-matches" style="text-align: center; padding: 10px; display: none;">No matches found</div>
        {{else}}
            <div class="tray-title-small" style="text-align: center; padding: 10px;">No weapons available</div>
        {{/if}}
    </div>
</div>


