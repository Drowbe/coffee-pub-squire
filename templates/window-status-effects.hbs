<div class="blacksmith-window-template-root status-effects-window" data-app-id="{{appId}}">
    <header class="blacksmith-window-template-header">
        <div class="blacksmith-window-template-header-content">
            <div class="blacksmith-window-template-header-icon status-effects-window-portrait">
                <img src="{{actorImg}}" alt="{{actorName}}">
            </div>
            <div class="blacksmith-window-template-header-title-block">
                <div class="blacksmith-window-template-header-title">Status Effects</div>
                <div class="blacksmith-window-template-header-subtitle">{{actorName}}</div>
            </div>
        </div>
    </header>

    <div class="blacksmith-window-template-body">
        <section class="blacksmith-window-section">
            <div class="blacksmith-window-section-header">
                <i class="fa-solid fa-sparkles"></i>
                <span>Conditions</span>
            </div>
            <div class="blacksmith-window-section-body">
                <div class="status-effects-grid">
                    {{#each conditions}}
                        <div class="status-effect-option-wrap">
                            <button
                                type="button"
                                class="status-effect-option {{#if isActive}}active{{/if}}"
                                data-action="toggleEffect"
                                data-condition-id="{{id}}"
                                aria-pressed="{{#if isActive}}true{{else}}false{{/if}}"
                                {{#unless ../canManage}}disabled{{/unless}}
                            >
                                <span class="status-effect-icon">
                                    <img src="{{icon}}" alt="" onerror="this.src='icons/svg/unknown.svg'; this.onerror=null;">
                                    {{#if isActive}}<i class="fa-solid fa-check status-effect-check"></i>{{/if}}
                                </span>
                                <span class="status-effect-name">{{name}}</span>
                                {{#if levelLabel}}<span class="status-effect-level">{{levelLabel}}</span>{{/if}}
                            </button>
                            <button
                                type="button"
                                class="status-effect-description-button"
                                data-action="showDescription"
                                data-condition-id="{{id}}"
                                aria-label="Show {{name}} description"
                                data-tooltip="Show description"
                            >
                                <i class="fa-solid fa-circle-info"></i>
                            </button>
                        </div>
                    {{/each}}
                </div>
            </div>
        </section>

        <section class="blacksmith-window-section status-effects-other-section">
            <div class="blacksmith-window-section-header">
                <i class="fa-solid fa-wand-magic-sparkles"></i>
                <span>Other Effects</span>
            </div>
            <div class="blacksmith-window-section-body">
                {{#if hasOtherEffects}}
                    <div class="status-effects-list">
                        {{#each otherEffects}}
                            <div class="status-effects-list-row {{#if isDisabled}}is-disabled{{/if}} {{#if isSuppressed}}is-suppressed{{/if}}">
                                <img class="status-effects-list-icon" src="{{icon}}" alt="">
                                <button
                                    type="button"
                                    class="status-effects-list-details"
                                    data-action="showDescription"
                                    data-effect-id="{{id}}"
                                    aria-label="Show {{name}} description"
                                >
                                    <span class="status-effects-list-name">{{name}}</span>
                                    <span class="status-effects-list-meta">
                                        {{#if duration}}<span>{{duration}}</span>{{/if}}
                                        {{#if isDisabled}}<span>Disabled</span>{{/if}}
                                        {{#if isSuppressed}}<span>Suppressed</span>{{/if}}
                                    </span>
                                </button>
                                <button
                                    type="button"
                                    class="status-effects-remove-effect blacksmith-window-btn-critical"
                                    data-action="removeEffect"
                                    data-effect-id="{{id}}"
                                    aria-label="Remove {{name}}"
                                    data-tooltip="Remove {{name}}"
                                    {{#unless ../canManage}}disabled{{/unless}}
                                >
                                    <i class="fa-solid fa-trash-can"></i>
                                </button>
                            </div>
                        {{/each}}
                    </div>
                {{else}}
                    <div class="status-effects-empty">No other effects.</div>
                {{/if}}
            </div>
        </section>

        {{#if selectedDescription}}
            <section class="blacksmith-window-section status-effects-description-section">
                <div class="blacksmith-window-section-header">
                    <img src="{{selectedDescription.icon}}" alt="">
                    <span>{{selectedDescription.name}}</span>
                </div>
                <div class="blacksmith-window-section-body status-effects-description-content">
                    {{{selectedDescription.html}}}
                </div>
            </section>
        {{/if}}
    </div>

    <section class="blacksmith-window-template-buttons">
        <div class="blacksmith-window-template-action-bar">
            <div class="blacksmith-window-template-action-left">
                <button
                    type="button"
                    class="blacksmith-window-btn-critical"
                    data-action="removeAll"
                    {{#unless canRemoveAll}}disabled{{/unless}}
                >
                    <i class="fa-solid fa-trash-can"></i>
                    Remove All
                </button>
            </div>
            <div class="blacksmith-window-template-action-right">
                <button type="button" class="blacksmith-window-btn-secondary" data-action="close">Close</button>
            </div>
        </div>
    </section>
</div>
