<div class="builds-panel">
<div class="section-header">
    <div class="header-left">
        <i class="fa-solid fa-shirt"></i> Builds
    </div>
    <div class="header-right">
        <i class="fa-solid fa-plus builds-create" data-tooltip="New build"></i>
    </div>
</div>

    {{!-- Full-width rows rather than a grid of squares. A build's identity is
          what is in it, and three 104px squares had room for a generic shirt and
          a fraction. A row has room for the gear itself, which is the thing
          anybody is actually choosing between. --}}
    <div class="builds-list">
        {{#if hasBuilds}}
        {{#each builds}}
        <div class="build-tile" data-build-id="{{this.id}}"
             data-tooltip="Open {{this.name}}<br><em>Right-click for more</em>">
            <div class="build-tile-top">
                <div class="build-tile-preview">
                    {{#each this.preview}}
                    <img src="{{this.img}}" alt="{{this.name}}" data-tooltip="{{this.name}}">
                    {{else}}
                    <span class="build-tile-empty">Nothing in this build yet</span>
                    {{/each}}
                </div>
                {{!-- Apply is its own target, never the row. Clicking a build to
                      look at it must not re-equip the character. --}}
                <button type="button" class="build-tile-apply" data-build-id="{{this.id}}"
                        data-tooltip="Equip this build on {{../actorName}}">
                    <i class="fa-solid fa-person-running"></i>
                </button>
            </div>

            <div class="build-tile-name">{{this.name}}</div>

            <div class="build-tile-stats">
                <span data-tooltip="Estimated armour class from this build's armour, shield and Dexterity. Class features and effects are not counted.">
                    <i class="fa-solid fa-shield"></i> {{this.armorClass}}
                </span>
                <span data-tooltip="Gear slots filled">
                    <i class="fa-solid fa-shirt"></i> {{this.gearCount}}/{{this.gearMax}}
                </span>
                {{#if this.spellCount}}
                <span data-tooltip="Spells this build prepares">
                    <i class="fa-solid fa-sparkles"></i> {{this.spellCount}}
                </span>
                {{/if}}
                {{#if this.weight}}
                <span data-tooltip="What this build's gear weighs">
                    <i class="fa-solid fa-weight-hanging"></i> {{this.weight}}
                </span>
                {{/if}}
                {{#if this.missingCount}}
                <span class="build-tile-warning" data-tooltip="Items in this build are no longer on the sheet">
                    <i class="fa-solid fa-triangle-exclamation"></i> {{this.missingCount}}
                </span>
                {{/if}}
            </div>
        </div>
        {{/each}}
        {{else}}
        <div class="squire-empty-message builds-empty">
            <p>- No Builds Yet -</p>
            <p>Use the + above to start one</p>
        </div>
        {{/if}}
    </div>
</div>
