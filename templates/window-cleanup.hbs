{{!-- Character sheet cleanup: the plan, then the receipt.

     Two states in one template. Before applying it shows what WOULD change and
     lets each row be unticked; after, it shows what did.

     Everything structural here is a shared `.squire-tool-*` component from
     styles/window-tool-shared.css — the same sections and rows the Transfer
     window uses. Only the handful of cleanup-specific pieces live in
     styles/window-cleanup.css. --}}

<div class="squire-tool-content squire-cleanup">

{{#if snapshot}}
    {{!-- Offered on every state, not just the receipt. The moment somebody
          wants a merge back is rarely the moment they finished it. --}}
    <section class="squire-tool-section squire-cleanup-undo">
        <h3>
            <span><i class="fa-solid fa-rotate-left"></i> Undo the last merge</span>
            <span class="squire-tool-count">{{snapshot.count}}</span>
        </h3>
        <p class="squire-tool-note">
            {{snapshot.count}} stack{{#unless (eq snapshot.count 1)}}s were{{else}} was{{/unless}} saved
            before the merge on {{snapshot.atLabel}}. Restoring puts them back with their original ids, so
            favourites that pointed at them resolve again.
        </p>
        <div class="squire-tool-row-actions squire-cleanup-undo-actions">
            <button type="button" class="blacksmith-window-btn-secondary" data-action="revert" {{#if busy}}disabled{{/if}}>
                <i class="fa-solid fa-rotate-left"></i> Restore
            </button>
        </div>
    </section>
{{/if}}

{{#if result}}
    {{!-- ================= RECEIPT ================= --}}
    <div class="squire-tool-banner">
        <i class="fa-solid fa-circle-check"></i>
        <div><p>Cleanup applied to <strong>{{actorName}}</strong>.</p></div>
    </div>

    {{#if result.currency}}
    <section class="squire-tool-section">
        <h3>
            <span><i class="fa-solid fa-coins"></i> Currency consolidated</span>
            <span class="squire-tool-count">{{result.coinCountBefore}} &rarr; {{result.coinCountAfter}}</span>
        </h3>
        <div class="squire-tool-coins">
            <span class="squire-cleanup-coins-label">Was</span>
            {{#each result.beforeCoins}}
                <span class="squire-tool-coin{{#if this.moved}} squire-tool-coin-was{{/if}}">{{this.before}} <small>{{this.label}}</small></span>
            {{/each}}
        </div>
        <div class="squire-tool-coins squire-cleanup-coins-after">
            <span class="squire-cleanup-coins-label">Now</span>
            {{#each result.afterCoins}}
                <span class="squire-tool-coin{{#if this.moved}} squire-tool-coin-is{{/if}}">{{this.after}} <small>{{this.label}}</small></span>
            {{/each}}
        </div>
        <div class="squire-tool-total">
            <span>Total value, unchanged</span>
            <strong>{{result.totalLabel}}</strong>
        </div>
    </section>
    {{/if}}

    {{#if result.linked}}
    <section class="squire-tool-section">
        <h3>
            <span><i class="fa-solid fa-link"></i> Items linked</span>
            <span class="squire-tool-count">{{result.linked}}</span>
        </h3>
        <p class="squire-tool-note">
            {{result.linked}} item{{#unless (eq result.linked 1)}}s{{/unless}}
            {{#if (eq result.linked 1)}}is{{else}}are{{/if}} now linked to
            {{#if (eq result.linked 1)}}its{{else}}their{{/if}} compendium entry, and can be refreshed
            from it if the world changes underneath {{#if (eq result.linked 1)}}it{{else}}them{{/if}}.
        </p>
    </section>
    {{/if}}

    {{#if result.merged}}
    <section class="squire-tool-section">
        <h3>
            <span><i class="fa-solid fa-layer-group"></i> Duplicates merged</span>
            <span class="squire-tool-count">{{result.merged}}</span>
        </h3>
        <p class="squire-tool-note">
            {{result.merged}} stack{{#unless (eq result.merged 1)}}s were{{else}} was{{/unless}} folded
            together and {{result.removed}} duplicate row{{#unless (eq result.removed 1)}}s{{/unless}}
            removed. Favourites pointing at a removed row now point at the one that stayed.
        </p>
    </section>
    {{/if}}

    {{#if result.failed}}
    <section class="squire-tool-section squire-cleanup-failed">
        <h3>
            <span><i class="fa-solid fa-triangle-exclamation"></i> Not applied</span>
            <span class="squire-tool-count">{{result.failed}}</span>
        </h3>
        <p class="squire-tool-note">
            {{result.failed}} change{{#unless (eq result.failed 1)}}s{{/unless}} could not be made.
            The console has the details.
        </p>
    </section>
    {{/if}}


{{else if hasWork}}
    {{!-- ================= PLAN ================= --}}
    <div class="squire-tool-banner">
        <i class="fa-solid fa-broom"></i>
        <div>
            <p>Nothing is created, removed, or replaced. Coins are re-counted into the same value, and
               items are linked to the compendium entry they came from.</p>
            <p>Untick anything you would rather leave alone.</p>
            {{!-- Phase 1 cannot lose anything, but it also cannot be undone: the
                  coin split is not recoverable from the total, and a written
                  source is not distinguishable afterwards from one that was
                  always there. Saying "safe" without saying "one-way" is the
                  half of the truth that gets someone burned. --}}
            <p class="squire-cleanup-backup">
                <i class="fa-solid fa-triangle-exclamation"></i>
                <span>There is no undo. If you want a way back, duplicate the actor — or right-click it in
                      the sidebar and Export Data — before applying.</span>
            </p>
        </div>
    </div>

    {{#if scan.currency.changed}}
    <section class="squire-tool-section">
        <h3>
            <span><i class="fa-solid fa-coins"></i> Consolidate currency</span>
            <span class="squire-tool-count">{{scan.currency.coinCountBefore}} &rarr; {{scan.currency.coinCountAfter}}</span>
        </h3>
        <label class="squire-tool-row squire-tool-row-select squire-cleanup-currency-row">
            <input type="checkbox" class="squire-tool-check-input" data-cleanup="currency" checked>
            <span class="squire-tool-check" aria-hidden="true"></span>
            <div class="squire-cleanup-currency-body">
                <div class="squire-tool-coins">
                    <span class="squire-cleanup-coins-label">Now</span>
                    {{#each scan.currency.beforeCoins}}
                        <span class="squire-tool-coin{{#if this.moved}} squire-tool-coin-was{{/if}}">{{this.before}} <small>{{this.label}}</small></span>
                    {{/each}}
                </div>
                <div class="squire-tool-coins">
                    <span class="squire-cleanup-coins-label">After</span>
                    {{#each scan.currency.afterCoins}}
                        <span class="squire-tool-coin{{#if this.moved}} squire-tool-coin-is{{/if}}">{{this.after}} <small>{{this.label}}</small></span>
                    {{/each}}
                </div>
            </div>
        </label>
        {{!-- The claim is "same money, fewer coins". This is the line that lets
              it be checked rather than believed. --}}
        <div class="squire-tool-total">
            <span>Total value, before and after</span>
            <strong>{{scan.currency.totalLabel}}</strong>
        </div>
    </section>
    {{/if}}

    {{#if scan.candidateCount}}
    <section class="squire-tool-section">
        <h3>
            <span><i class="fa-solid fa-link"></i> Link items to their compendium entry</span>
            <span class="squire-tool-count">{{scan.candidateCount}}</span>
        </h3>
        <p class="squire-tool-note">
            An item dragged onto a sheet is a copy, and by default it keeps no record of what it is a copy
            of. Recording that link is what lets it be repaired later: if the entry it came from is edited,
            renamed, or deleted, a linked item can still be refreshed from the compendium, while an
            unlinked one is stranded with whatever it happened to hold that day.
        </p>
        <p class="squire-tool-note">Nothing is replaced now — this only writes the link.</p>

        {{#if scan.links.review.length}}
            {{!-- Attention first, and said in the heading so the order is not
                  something the GM has to infer from the rows. --}}
            <div class="squire-cleanup-subhead squire-cleanup-subhead-warn">
                <i class="fa-solid fa-circle-exclamation"></i>
                <span>Check these {{scan.links.review.length}}: the compendium entry is not named the
                      same as the item, so they are left unticked.</span>
            </div>
            <div class="squire-tool-list">
                {{#each scan.links.review}}
                <label class="squire-tool-row squire-tool-row-select">
                    <input type="checkbox" class="squire-tool-check-input" data-cleanup="link"
                           data-item-id="{{this.id}}" data-uuid="{{this.uuid}}">
                    <span class="squire-tool-check" aria-hidden="true"></span>
                    <img class="squire-tool-row-img" src="{{this.img}}" alt="">
                    <div class="squire-tool-row-copy">
                        <strong>{{this.name}}</strong>
                        <span>&rarr; {{this.matchedName}}{{#if this.sourceLabel}} · {{this.sourceLabel}}{{/if}}</span>
                    </div>
                    <span class="squire-tool-flag"><i class="fa-solid fa-triangle-exclamation"></i> {{this.reason}}</span>
                </label>
                {{/each}}
            </div>
        {{/if}}

        {{#if scan.links.ready.length}}
            <div class="squire-cleanup-subhead">
                <i class="fa-solid fa-circle-check"></i>
                <span>{{scan.links.ready.length}} matched by exactly the same name, and are ticked.</span>
            </div>
            <div class="squire-tool-list">
                {{#each scan.links.ready}}
                <label class="squire-tool-row squire-tool-row-select">
                    <input type="checkbox" class="squire-tool-check-input" data-cleanup="link"
                           data-item-id="{{this.id}}" data-uuid="{{this.uuid}}" checked>
                    <span class="squire-tool-check" aria-hidden="true"></span>
                    <img class="squire-tool-row-img" src="{{this.img}}" alt="">
                    <div class="squire-tool-row-copy">
                        <strong>{{this.name}}</strong>
                        <span>{{this.sourceLabel}}</span>
                    </div>
                    <span class="squire-cleanup-aside">{{this.typeLabel}}</span>
                </label>
                {{/each}}
            </div>
        {{/if}}
    </section>
    {{/if}}

    {{#if scan.duplicates.groups.length}}
    <section class="squire-tool-section">
        <h3>
            <span><i class="fa-solid fa-layer-group"></i> Merge duplicate stacks</span>
            <span class="squire-tool-count">{{scan.duplicates.groups.length}}</span>
        </h3>
        <p class="squire-tool-note">
            These are the same item recorded more than once. Two copies only qualify if they came from the
            same compendium entry <strong>and</strong> everything else about them is identical — so a copy
            that is equipped, in a different bag, unidentified, or edited is left alone and listed below.
        </p>
        <p class="squire-tool-note">
            <strong>This deletes rows.</strong> The quantities are added together on the row that stays, and
            the ones removed are saved first so the merge can be undone.
        </p>
        <div class="squire-tool-list">
            {{#each scan.duplicates.groups}}
            <label class="squire-tool-row squire-tool-row-select">
                <input type="checkbox" class="squire-tool-check-input" data-cleanup="merge"
                       data-survivor-id="{{this.survivorId}}" data-loser-ids="{{this.loserIdsCsv}}" checked>
                <span class="squire-tool-check" aria-hidden="true"></span>
                <img class="squire-tool-row-img" src="{{this.img}}" alt="">
                <div class="squire-tool-row-copy">
                    <strong>{{this.name}}</strong>
                    {{!-- The equipped note is not decoration: it is the one thing a
                          merge decides rather than preserves, so it is said before
                          Apply rather than discovered after. --}}
                    <span>{{this.stacks}} rows &rarr; 1{{#if this.favourited}} · favourited{{/if}}{{#if this.equipped}} · {{#if this.mixedEquipped}}will stay equipped{{else}}equipped{{/if}}{{/if}}</span>
                </div>
                <span class="squire-cleanup-aside">qty {{this.totalQuantity}}</span>
            </label>
            {{/each}}
        </div>
    </section>
    {{/if}}

    {{#if scan.duplicates.blocked.length}}
    <section class="squire-tool-section">
        <h3>
            <span><i class="fa-solid fa-hand"></i> Duplicates to be left alone</span>
            <span class="squire-tool-count">{{scan.duplicates.blocked.length}}</span>
        </h3>
        <p class="squire-tool-note">
            Recorded more than once, but not safe to fold together. Nothing is done to these — the reason is
            shown so you can decide whether to reconcile them by hand.
        </p>
        <div class="squire-tool-list">
            {{#each scan.duplicates.blocked}}
            <div class="squire-tool-row">
                <img class="squire-tool-row-img" src="{{this.img}}" alt="">
                <div class="squire-tool-row-copy">
                    <strong>{{this.name}}</strong>
                    <span>{{this.count}} copies &mdash; {{this.reason}}</span>
                </div>
                <span class="squire-tool-flag"><i class="fa-solid fa-hand"></i> Skipped</span>
            </div>
            {{/each}}
        </div>
    </section>
    {{/if}}

    {{#if scan.mergeNeedsRescan}}
    <p class="squire-tool-note squire-cleanup-quiet">
        Merging identifies a duplicate by its compendium entry, so anything linked above only becomes a
        merge candidate the next time you open this window.
    </p>
    {{/if}}

    {{#if scan.links.unmatched.length}}
    <section class="squire-tool-section">
        <h3>
            <span><i class="fa-solid fa-circle-question"></i> No compendium match</span>
            <span class="squire-tool-count">{{scan.links.unmatched.length}} of {{scan.links.considered}}</span>
        </h3>
        <p class="squire-tool-note">
            Nothing is done to these. Class features, species traits, and homebrew are usually not in the
            compendiums you have configured, so a large number here is expected rather than a problem.
        </p>
        <ul class="squire-cleanup-breakdown">
            {{#each scan.links.unmatchedByType}}
                <li><strong>{{this.count}}</strong> {{this.label}}</li>
            {{/each}}
        </ul>
    </section>
    {{/if}}

    {{#if scan.links.alreadyLinked}}
    <p class="squire-tool-note squire-cleanup-quiet">
        {{scan.links.alreadyLinked}} of {{scan.links.considered}} are already linked to their compendium
        entry and are left alone.
    </p>
    {{/if}}


{{else}}
    {{!-- ================= NOTHING TO DO ================= --}}
    <div class="squire-tool-banner">
        <i class="fa-solid fa-circle-check"></i>
        <div><p><strong>{{actorName}}</strong> is tidy. Coins are already consolidated, and every item that
               could be matched is linked to its compendium entry.</p></div>
    </div>
{{/if}}

</div>
