<div class="tray-title-small">
<span>Character Sheet</span>
{{#if canUseCompendiums}}
<div class="control-mode-toggles">
    <i class="fa-solid fa-user control-mode-toggle" data-mode="sheet" title="Show This Character's Items"></i>
    <i class="fa-solid fa-magnifying-glass control-mode-toggle" data-mode="search" title="{{compendiumToggleTitle}}"></i>
</div>
{{/if}}
</div>
<div class="control-search">
<input type="text" class="global-search" placeholder="Search All Sections...">
<i class="fa-solid fa-times search-clear" title="Clear Search"></i>
</div>
{{#if canAddFromCompendiums}}
<label class="control-search-option" title="On: adding empties the search box and stays here, for adding several things. Off: adding returns to the character sheet and scrolls to the new item.">
<input type="checkbox" class="compendium-clear-on-add" {{#if clearOnAdd}}checked{{/if}}>
<span>Clear search and keep open on add</span>
</label>
{{/if}}
<div class="control-icons">
<i class="fa-solid fa-heart control-toggle" data-toggle-panel="favorites" title="Toggle Favorites Panel"></i>
<i class="fa-solid fa-swords control-toggle" data-toggle-panel="weapons" title="Toggle Weapons Panel"></i>
<i class="fa-solid fa-sparkles control-toggle" data-toggle-panel="spells" title="Toggle Spells Panel"></i>
<i class="fa-solid fa-stars control-toggle" data-toggle-panel="features" title="Toggle Features Panel"></i>
<i class="fa-solid fa-backpack control-toggle" data-toggle-panel="inventory" title="Toggle Inventory Panel"></i>
</div>
