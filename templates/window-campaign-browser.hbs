{{!--
    Host shell for a campaign browser panel.

    The PART template supplies the whole window structure — root, header, body —
    which is the convention the other Squire windows follow and what the
    `blacksmith-window-template-*` styles key off. Without the body element
    there is no bounded flex column above the panel's own scroller, and the
    content runs past the bottom of the window with no scrollbar.

    `squire-panel-host` + `data-position="left"` is what the panel stylesheets
    key off. Deliberately NOT `squire-tray` — that class carries the tray's own
    fixed positioning and slide-in transform, which would fight the window frame.
--}}
<div class="blacksmith-window-template-root campaign-browser-window" id="{{appId}}">
    <header class="blacksmith-window-template-header">
        <div class="blacksmith-window-template-header-content">
            <div class="blacksmith-window-template-header-icon">
                <i class="{{headerIcon}}"></i>
            </div>
            <div class="blacksmith-window-template-header-title-block">
                <div class="blacksmith-window-template-header-title">{{headerTitle}}</div>
            </div>
        </div>
    </header>

    <div class="blacksmith-window-template-body">
        <div class="squire-panel-host campaign-browser-body" data-position="left">
            <div class="panel-container" data-panel="{{panelKey}}"></div>
        </div>
    </div>
</div>
