<!-- PARTY CHARACTERS -->

{{#each tokens as |token|}}
    <div class="party-card {{#if token.actor.isOwner}}party-card-clickable{{/if}} {{#if (includes ../controlledTokenIds token.id)}}party-card-selected{{/if}}" data-token-id="{{token.id}}">
        <div class="party-card-image party-card-clickable" style="background-image: url('{{token.actor.img}}')" title="Click to share portrait with all players">
            {{#if token.actor.system.attributes.hp}}
            <div class="health-overlay" style="height: {{healthOverlayHeight token.actor.system.attributes.hp}}"></div>
            {{#if (eq token.actor.system.attributes.hp.value 0)}}
            <i class="fa-solid fa-skull death-skull"></i>
            {{/if}}
            {{/if}}
        </div>
        <div class="party-card-info">
            <div class="party-card-name">{{token.name}}</div>
            <div class="party-card-details">
                <div class="party-card-details-primary">
                    {{#if (eq token.actor.type "character")}}
                        {{#each token.actor.items as |item|}}
                            {{#if (eq item.type "class")}}
                                {{item.name}} • Level {{item.system.levels}}
                            {{/if}}
                        {{/each}}
                    {{else}}
                        {{#if token.actor.system.details.cr}}CR {{token.actor.system.details.cr}}{{/if}}
                    {{/if}}
                    {{#if token.speedDisplay}} • {{token.speedDisplay}}{{/if}}
                    {{!-- Disposition. Drawn on every NPC, but on a player card only when it is
                    NOT friendly: a party panel that labels every ally FRIENDLY is
                    labelling the default, which is noise on the common case and
                    makes the rare one harder to spot rather than easier. --}}
                    {{#if (ne token.disposition.key "friendly")}}
                    <span class="squire-disposition disposition-{{token.disposition.key}}">{{token.disposition.label}}</span>
                    {{/if}}
                </div>
                <div class="party-card-details-secondary">
                    {{#if (ne token.actor.type "character")}}
                        <div>RESISTANCES: {{#if token.actor.system.traits.dr.value}}{{#each token.actor.system.traits.dr.value}}{{#unless @first}}, {{/unless}}{{this}}{{/each}}{{else}}None{{/if}}</div>
                        <div>IMMUNITITES: {{#if token.actor.system.traits.di.value}}{{#each token.actor.system.traits.di.value}}{{#unless @first}}, {{/unless}}{{this}}{{/each}}{{else}}None{{/if}}</div>
                    {{/if}}
                </div>
                {{#if token.actor.system.attributes.hp}}
                    <div class="party-hp-bar">
                        <div class="hp-current">
                            <span class="hp-value">{{token.actor.system.attributes.hp.value}}</span>
                        </div>
                        <div class="hp-fill {{token.healthbarStatus}}" style="width: {{multiply (divide token.actor.system.attributes.hp.value token.actor.system.attributes.hp.max) 100}}%"></div>
                        <div class="hp-max">
                            <span class="hp-value">{{token.actor.system.attributes.hp.max}}</span>
                        </div>
                    </div>
                {{/if}}
            </div>
        </div>
        <div class="party-card-actions">
            {{#if token.actor.isOwner}}
            <i class="fa-solid fa-feather-alt open-sheet" title="Open Character Sheet"></i>
            {{/if}}
        </div>
    </div>
{{else}}
    <div class="squire-empty-message no-party-message">
        <p>- No Party Tokens to Display -</p>
        <p>Add tokens to the scene to get started</p>
    </div>
{{/each}}

<!-- MONSTER AND NPC CHARACTERS -->

{{#if isGM}}
    {{#if nonPlayerTokens.length}}
        <div class="section-divider">
            <span class="divider-text">MONSTERS & NPCs</span>
        </div>
        
        {{#each nonPlayerTokens as |token|}}
            <div class="party-card party-npc-card {{#if token.actor.isOwner}}party-card-clickable{{/if}} {{#if (includes ../controlledTokenIds token.id)}}party-card-selected{{/if}}" data-token-id="{{token.id}}">
                <div class="party-card-image party-card-clickable" style="background-image: url('{{token.actor.img}}')" title="Click to share portrait with all players">
                    {{#if token.actor.system.attributes.hp}}
                    <div class="health-overlay" style="height: {{healthOverlayHeight token.actor.system.attributes.hp}}"></div>
                    {{#if (eq token.actor.system.attributes.hp.value 0)}}
                    <i class="fa-solid fa-skull death-skull"></i>
                    {{/if}}
                    {{/if}}
                </div>
                <div class="party-card-info">
                    <div class="party-card-name">{{token.name}}</div>
                    <div class="party-card-details">
                        <div class="party-card-details-primary">
                            {{#if token.actor.system.details.cr}}CR {{token.actor.system.details.cr}}{{/if}}
                            {{#if token.speedDisplay}} • {{token.speedDisplay}}{{/if}}
                            <span class="squire-disposition disposition-{{token.disposition.key}}">{{token.disposition.label}}</span>
                        </div>
                        <div class="party-card-details-secondary">
                            <div>RESISTANCES: {{#if token.actor.system.traits.dr.value}}{{#each token.actor.system.traits.dr.value}}{{#unless @first}}, {{/unless}}{{this}}{{/each}}{{else}}None{{/if}}</div>
                            <div>IMMUNITITES: {{#if token.actor.system.traits.di.value}}{{#each token.actor.system.traits.di.value}}{{#unless @first}}, {{/unless}}{{this}}{{/each}}{{else}}None{{/if}}</div>
                        </div>
                        {{#if token.actor.system.attributes.hp}}
                        <div class="party-hp-bar">
                            <div class="hp-current">
                                <span class="hp-value">{{token.actor.system.attributes.hp.value}}</span>
                            </div>
                            <div class="hp-fill {{token.healthbarStatus}}" style="width: {{multiply (divide token.actor.system.attributes.hp.value token.actor.system.attributes.hp.max) 100}}%"></div>
                            <div class="hp-max">
                                <span class="hp-value">{{token.actor.system.attributes.hp.max}}</span>
                            </div>
                        </div>
                        {{/if}}
                    </div>
                </div>
                <div class="party-card-actions">
                    <i class="fa-solid fa-feather-alt open-sheet" title="Open Character Sheet"></i>
                </div>
            </div>
        {{/each}}
    {{/if}}
{{/if}} 

{{!-- Shown by the name filter when nothing matches. Hidden markup rather than a
      JS-built node so it reads like the empty-roster message above it. --}}
<div class="squire-empty-message party-search-empty" hidden>
    <p>- No Matching Characters -</p>
    <p>Nothing on this scene matches that name</p>
</div>
