<div class="squire-tray squire-panel-host">
    
    <!-- TRAY HANDLE -->

    <div class="tray-handle">

        {{!-- HP RAIL

              A thin column down the handle's OUTER edge, filled from the bottom
              and coloured by severity. The peripheral-vision readout: you
              register the colour and the level while you are looking at the
              canvas, and read the number off the chip under the portrait when
              you actually look at the strip.

              It is also the one piece of status that survives the tray being
              open, because everything else on the handle is duplicated by a
              panel a few pixels to the left and HP is not.

              Lives here rather than in the handle partials for a mechanical
              reason: it is positioned in the handle's right padding, outside
              .tray-handle-content-container, which is `overflow: hidden` --
              anywhere inside that container the clip would eat it. HandleManager
              fills it in `_updateHpRail()` for the same reason it cannot be a
              Handlebars expression here: this template renders once, and the
              handle re-renders on every health change.

              Not clickable and not focusable: it lies on top of the handle's own
              toggle target, and a 4px strip is not a control. --}}
        <div class="handle-hp-rail" aria-hidden="true">
            <div class="handle-hp-rail-fill"></div>
        </div>

        <div class="tray-handle-content-container">

            {{!-- The pin at the head, where people look for it. --}}
            <button class="squire-handle-control tray-handle-button-pin" title="Pin Tray">
                <i class="fa-solid fa-thumbtack"></i>
            </button>

            <div class="tray-handle-content-wrapper">
                {{#if (eq viewMode 'player')}}
                    {{> handle-player}}
                {{else if (eq viewMode 'party')}}
                    {{> handle-party}}
                {{else}}
                    {{> handle-player}}
                {{/if}}
            </div>

            {{!-- Minimal / full width, sitting directly above the caret.

                  It only changes the CLOSED handle. Open, the strip is always
                  minimal: the tray is right there, so being wide buys nothing
                  and costs the panels 14px.

                  Above the caret rather than up with the pin because it is a
                  statement about the handle's shape, and the caret is the other
                  one — pin is about the tray. --}}
            <button class="squire-handle-control tray-handle-button-mode" title="Handle Width">
                <i class="fa-solid fa-arrows-left-right"></i>
            </button>

            {{!-- The collapse caret at the FOOT, which is where core Foundry
                  keeps its own sidebar collapse control. Matching the
                  application beats internal tidiness: this is a control people
                  already know where to find, and moving it to sit next to the
                  pin made it a control they had to learn.

                  fa-caret-right is Foundry's own collapse glyph; CSS flips it
                  when the tray is open.

                  Last in the DOM, and that is what puts it here — the content
                  wrapper above is the flex item that grows. No `order` juggling
                  any more, so what you read is what you see. --}}
            <button class="squire-handle-control tray-handle-button-toggle" title="Toggle Tray">
                <i class="fa-solid fa-caret-right"></i>
            </button>
        </div>
        <div class="tray-handle-fade-bottom"></div>
    </div>

    

    <!-- TRAY CONTENT -->

    <div class="tray-content">


        <!-- TRAY TABS -->

        <div class="tray-view-tabs">
            <button class="tray-tab-button {{#if (eq viewMode 'player')}}active{{/if}}" data-view="player" title="Character">
                <i class="fa-solid fa-user"></i> Character
            </button>
            {{#if showTabParty}}
            <button class="tray-tab-button {{#if (eq viewMode 'party')}}active{{/if}}" data-view="party" title="Party View">
                <i class="fa-solid fa-users"></i> Party
            </button>
            {{/if}}
        </div>

        <!-- PANELS -->

        <div class="tray-panel-wrapper">


            <!-- ********** GLOBAL PANELS ********** -->

            <!-- Global Progress Bar -->

            <div class="tray-progress-bar-wrapper" style="display: none;">
                <div class="tray-progress-bar-outter">
                    <div class="tray-progress-bar-inner"><span class="tray-progress-bar-text">Ready...</span></div>
                </div>
            </div>

            <!-- Party Toolbar -->

            <div class="tray-tools-toolbar {{#unless (eq viewMode 'party')}}hidden{{/unless}}">
                {{!-- One labelled primary action, then a right-aligned icon rail.
                      Only the primary carries a word, so the row cannot wrap
                      however many tools end up on it. --}}
                {{#if isGM}}
                    <button class="tray-tools-primary" data-action="experience">
                        <i class="fa-solid fa-medal"></i><span>Experience</span>
                    </button>
                {{/if}}
                <div class="tray-tools-rail">
                    <button class="tray-tools-icon" data-action="select-party"
                            data-tooltip="{{#if isGM}}Select the whole party{{else}}Select the characters you own{{/if}}"
                            aria-label="{{#if isGM}}Select Party{{else}}Select Owned{{/if}}">
                        <i class="fa-solid fa-users-viewfinder"></i>
                    </button>
                    {{#if canStartVote}}
                        <button class="tray-tools-icon" data-action="vote"
                                data-tooltip="Start a vote" aria-label="Vote">
                            <i class="fa-solid fa-check-to-slot"></i>
                        </button>
                    {{/if}}
                    {{#if canDeployParty}}
                        <button class="tray-tools-icon" data-action="deploy-party"
                                data-tooltip="Deploy all party members to the canvas" aria-label="Deploy Party">
                            <i class="fa-solid fa-map-location-dot"></i>
                        </button>
                        <button class="tray-tools-icon" data-action="clear-party"
                                data-tooltip="Remove all party member tokens from the canvas" aria-label="Clear Party">
                            <i class="fa-solid fa-users-slash"></i>
                        </button>
                    {{/if}}
                </div>
            </div>

            <!-- ********** PLAYER TAB ********** -->
            
            <div class="tray-view-content player-view {{#unless (eq viewMode 'player')}}hidden{{/unless}}">
                {{#if actor}}
                    <!-- CHARACTER - ALWAYS SHOW -->  
                    <div class="panel-container" data-panel="character"></div>


                    <!-- GM DETAILS -->
                    {{#if isGM}}{{#if @root.settings.showGmPanel}}
                        <div class="panel-container" data-panel="gm"></div>
                    {{/if}}{{/if}}


                    <!-- CHARACTER SUMMARY -->
                    {{#if @root.settings.showCharacterSummaryPanel}}
                        <div class="panel-container" data-panel="character-summary"></div>
                    {{/if}}

                    <!-- CONTROL PANEL - FOR FAVORITES - ALWAYS SHOWN -->  
                    <div class="panel-container" data-panel="control"></div>

                    <!-- COMPENDIUM QUICK-ADD - replaces the stack when active -->
                    <div class="panel-container" data-panel="compendium-search"></div>

                    <!-- FAVORITES -->
                    <div class="panel-containers stacked">
                        <div class="panel-container" data-panel="favorites"></div>
                        <div class="panel-container" data-panel="weapons"></div>
                        <div class="panel-container" data-panel="spells"></div>
                        <div class="panel-container" data-panel="features"></div>
                        <div class="panel-container" data-panel="inventory"></div>
                    </div>
                {{else}}
                    <div class="squire-empty-message no-character-message">
                        <p>NO TOKEN SELECTED OR OWNED</p>
                        <p>Select an owned token to get started.</p>
                        {{#if ownedCharacters}}
                        <div class="character-switcher no-character-switcher">
                            {{#each ownedCharacters}}
                            {{#if divider}}<div class="character-switcher-divider"></div>{{/if}}
                            <div class="character-switcher-chip{{#if active}} active{{/if}}{{#unless onScene}} off-scene{{/unless}}" data-actor-id="{{id}}" title="{{name}}{{#unless onScene}} (not on this scene){{/unless}}">
                                <img src="{{img}}" alt="{{name}}">
                            </div>
                            {{/each}}
                        </div>
                        {{/if}}
                    </div>
                {{/if}}
            </div>

            <!-- ********** PARTY TAB ********** -->

            <!-- Party Panels -->

            {{!--
                Two zones, not one scroller. Reputation, party health and the name
                filter are the tab's controls: they have to stay put while you scroll
                a long roster, or filtering a twenty-token scene means scrolling back
                up to reach the box you are typing in. Everything the filter acts on
                — the roster and the stats below it — lives in the scrolling half.
            --}}
            <div class="tray-view-content party-view {{#unless (eq viewMode 'party')}}hidden{{/unless}}">
                <div class="panel-container party-view-header" data-panel="party-header"></div>
                <div class="party-view-scroll">
                    <div class="panel-container" data-panel="party"></div>
                    {{#if @root.settings.showPartyStatsPanel}}
                    <div class="panel-container" data-panel="party-stats"></div>
                    {{/if}}
                </div>
            </div>



        </div>
    </div>
</div> 
