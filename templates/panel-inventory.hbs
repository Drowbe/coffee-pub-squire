{{#*inline "inventory-item"}}
<div draggable="true" class="panel-item {{#if system.equipped}}prepared{{/if}}" data-item-id="{{id}}" data-item-type="{{type}}" data-category-id="{{categoryId}}" data-action-types="{{actionTypes}}"{{#if equipState}} data-equip-state="{{equipState}}"{{/if}}>
    <div class="panel-item-row">
        <div class="panel-item-image-container">
            <img draggable="false" class="panel-item-image" src="{{img}}" alt="{{name}}"/>
            <i class="fa-solid fa-dice-d20 panel-item-roll-overlay"></i>
        </div>
        <div class="panel-item-name">
            <span class="panel-item-label">{{{name}}}</span>
            {{#if isNew}}<span class="new-tag">NEW</span>{{/if}}
            <span class="panel-item-context">
                {{> action-badge actionType=actionType}}
                {{#if canEditQuantity}}
                <span class="panel-item-badge context-count editable" data-quantity-edit title="Quantity — click to edit, 0 removes the item">x{{quantity}}</span>
                {{else if quantity}}
                <span class="panel-item-badge context-count" title="Quantity">x{{quantity}}</span>
                {{/if}}
            </span>
        </div>
        <div class="tray-buttons">
            {{#if isLightSource}}
            <i class="fa-solid fa-lightbulb {{#unless isLightActive}}faded{{/unless}} {{#if isLightActive}}light-active{{/if}}" title="Toggle Light"></i>
            {{/if}}
            {{#if container}}
            <i class="fa-solid fa-sack item-container-open" data-container-id="{{container.id}}" data-tooltip="Stored in <strong>{{container.name}}</strong><br><em>Click to open</em>"></i>
            {{/if}}
            {{#if (or (eq type "weapon") (eq type "equipment") (eq type "tool") (eq type "consumable"))}}
                {{#if system.equipped}}
                <i class="fa-solid fa-shield-alt" title="Toggle Equipped"></i>
                {{else}}
                <i class="fa-solid fa-shield-alt faded" title="Toggle Equipped"></i>
                {{/if}}
            {{/if}}
            <i class="fa-solid fa-share inventory-send-item" title="Send Item" data-item-id="{{id}}"></i>
            {{#if isFavorite}}
            <i class="fa-solid fa-heart" title="Toggle Favorite"></i>
            {{else}}
            <i class="fa-solid fa-heart faded" title="Toggle Favorite"></i>
            {{/if}}
            <i class="fa-solid fa-feather"></i>
        </div>
    </div>
</div>
{{/inline}}

<div class="inventory-panel">
<div class="section-header">
    <div class="header-left">
        <i class="fa-solid fa-backpack"></i> Inventory
    </div>
    <div class="header-right">
        {{#if (lookup itemsByType "equipment")}}<i class="fa-solid fa-shirt inventory-category-filter active" data-filter-id="category-inventory-equipment" title="Toggle Equipment"></i>{{/if}}
        {{#if (lookup itemsByType "consumable")}}<i class="fa-solid fa-flask inventory-category-filter active" data-filter-id="category-inventory-consumable" title="Toggle Consumables"></i>{{/if}}
        {{#if (lookup itemsByType "tool")}}<i class="fa-solid fa-hammer inventory-category-filter active" data-filter-id="category-inventory-tool" title="Toggle Tools"></i>{{/if}}
        {{#if (lookup itemsByType "loot")}}<i class="fa-solid fa-coins inventory-category-filter active" data-filter-id="category-inventory-loot" title="Toggle Loot"></i>{{/if}}
        {{#if (lookup itemsByType "container")}}<i class="fa-solid fa-box inventory-category-filter active" data-filter-id="category-inventory-container" title="Toggle Containers"></i>{{/if}}
    </div>
</div>

    <div class="inventory-list">
        {{!-- Currency first: it is the thing every player checks. Built in the
              same row shape as the items below, because it is part of the same
              list — it just does not happen to be an item. --}}
        {{#if currency}}
        <div class="category-header" data-category-id="category-inventory-currency">Currency</div>
        {{#each currency}}
        <div class="panel-item panel-item-currency" data-denomination="{{this.key}}" data-item-type="currency" data-category-id="category-inventory-currency" data-action-types="passive">
            <div class="panel-item-row">
                <div class="panel-item-image-container">
                    <img draggable="false" class="panel-item-image" src="{{this.img}}" alt="{{this.name}}"/>
                </div>
                <div class="panel-item-name">
                    <span class="panel-item-label">{{this.name}}</span>
                    <span class="panel-item-context">
                        <span class="panel-item-badge context-count" title="Coins">x{{this.quantity}}</span>
                    </span>
                </div>
                <div class="tray-buttons">
                    <i class="fa-solid fa-share currency-send" data-denomination="{{this.key}}" title="Send {{this.name}}"></i>
                    <i class="fa-solid fa-coins currency-convert" title="Consolidate coins into the fewest pieces"></i>
                </div>
            </div>
        </div>
        {{/each}}
        {{/if}}

        {{#if items}}
            {{!-- Equipment --}}
            {{#if (lookup itemsByType "equipment")}}
            <div class="category-header" data-category-id="category-inventory-equipment">Equipment</div>
            {{#each (lookup itemsByType "equipment") as |item|}}
            {{> inventory-item 
                id=item.id 
                img=item.img 
                name=item.name 
                actionType=item.actionType 
                system=item.system 
                quantity=item.system.quantity 
                canEditQuantity=item.canEditQuantity
                isFavorite=item.isFavorite 
                categoryId="category-inventory-equipment"
                type=item.type
                isLightSource=item.isLightSource
                isLightActive=item.isLightActive}}
            {{/each}}
            {{/if}}

            {{!-- Consumables --}}
            {{#if (lookup itemsByType "consumable")}}
            <div class="category-header" data-category-id="category-inventory-consumable">Consumables</div>
            {{#each (lookup itemsByType "consumable") as |item|}}
            {{> inventory-item 
                id=item.id 
                img=item.img 
                name=item.name 
                actionType=item.actionType 
                system=item.system 
                quantity=item.system.quantity 
                canEditQuantity=item.canEditQuantity
                isFavorite=item.isFavorite 
                categoryId="category-inventory-consumable"
                type=item.type
                isLightSource=item.isLightSource}}
            {{/each}}
            {{/if}}

            {{!-- Tools --}}
            {{#if (lookup itemsByType "tool")}}
            <div class="category-header" data-category-id="category-inventory-tool">Tools</div>
            {{#each (lookup itemsByType "tool") as |item|}}
            {{> inventory-item 
                id=item.id 
                img=item.img 
                name=item.name 
                actionType=item.actionType 
                system=item.system 
                quantity=item.system.quantity 
                canEditQuantity=item.canEditQuantity
                isFavorite=item.isFavorite 
                categoryId="category-inventory-tool"
                type=item.type
                isLightSource=item.isLightSource}}
            {{/each}}
            {{/if}}

            {{!-- Loot --}}
            {{#if (lookup itemsByType "loot")}}
            <div class="category-header" data-category-id="category-inventory-loot">Loot</div>
            {{#each (lookup itemsByType "loot") as |item|}}
            {{> inventory-item 
                id=item.id 
                img=item.img 
                name=item.name 
                actionType=item.actionType 
                system=item.system 
                quantity=item.system.quantity 
                canEditQuantity=item.canEditQuantity
                isFavorite=item.isFavorite 
                categoryId="category-inventory-loot"
                type=item.type
                isLightSource=item.isLightSource}}
            {{/each}}
            {{/if}}

            {{!-- Containers --}}
            {{#if (lookup itemsByType "container")}}
            <div class="category-header" data-category-id="category-inventory-container">Containers</div>
            {{#each (lookup itemsByType "container") as |item|}}
            {{> inventory-item 
                id=item.id 
                img=item.img 
                name=item.name 
                actionType=item.actionType 
                system=item.system 
                quantity=item.system.quantity 
                canEditQuantity=item.canEditQuantity
                isFavorite=item.isFavorite 
                categoryId="category-inventory-container"
                type=item.type
                isLightSource=item.isLightSource}}
            {{/each}}
            {{/if}}

        {{else}}
            <div class="tray-title-small" style="text-align: center; padding: 10px;">No items available</div>
        {{/if}}
    </div>
</div> 

