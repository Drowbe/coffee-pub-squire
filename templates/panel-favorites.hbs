<div class="favorites-panel">
<div class="section-header">
    <div class="header-left">
        <i class="fa-solid fa-heart"></i> Favorites
    </div>
    {{!--
        List or tiles, then clear-all.

        The layout switch lives here rather than in the Character Sheet strip
        above because it is a choice WITHIN this view, not a choice of view --
        the strip's three icons say where you are, and a fourth saying how this
        one is drawn would be a different kind of thing wearing the same clothes.
        Clear-all keeps the last slot it has always had.

        Two icons rather than one that toggles: a single button has to show
        either the state or the action and is read as the wrong one half the
        time. A pair is a two-position switch, which is what this is.
    --}}
    <div class="header-right">
        <i class="fa-solid fa-list favorites-layout-toggle{{#if (eq layout 'list')}} active{{/if}}"
           data-layout="list" data-tooltip="Show favourites as a list"></i>
        <i class="fa-solid fa-grid-2 favorites-layout-toggle{{#if (eq layout 'tiles')}} active{{/if}}"
           data-layout="tiles" data-tooltip="Show favourites as tiles"></i>
        <span class="favorites-header-separator"></span>
        {{!-- Sort opens a menu rather than being three more glyphs in the row.
              Three layout-ish icons and three sort icons side by side would be
              six controls saying two different kinds of thing, and the header is
              already carrying the clear-all. --}}
        <i class="fa-solid {{sortIcon}} favorites-sort-toggle" data-tooltip="Sort: {{sortLabel}}"></i>
        {{#if hasFavorites}}
        <span class="favorites-header-separator"></span>
        <i class="fa-solid fa-heart-circle-xmark favorites-clear-all" title="Clear All Favorites"></i>
        {{/if}}
    </div>
</div>

    {{!-- The tile layout is the same rows under a different class: every control
          on a row is delegated from the panel, so re-shaping them in CSS keeps
          rolling, equipping, unfavouriting and drag-to-handle working without a
          second copy of the markup to keep in step. --}}
    {{!-- Always groups, even when there is only one and it has no name. One
          copy of the row markup rather than a flat branch and a grouped branch
          that would have to be kept identical by hand. --}}
    <div class="favorites-list favorites-layout-{{layout}}{{#if grouped}} favorites-grouped{{/if}}">
        {{#if favorites}}
        {{#each groups}}
        {{#if this.label}}
        <div class="category-header favorites-category-header">{{this.label}}</div>
        {{/if}}
        {{#each this.items}}
        <div draggable="true" class="panel-item" 
             data-item-id="{{this.id}}" data-item-type="{{this.type}}"
             data-span="{{this.span}}"
             data-action-types="{{this.actionTypes}}"{{#if this.equipState}}
             data-equip-state="{{this.equipState}}"{{/if}}{{#if this.prepareState}}
             data-prepare-state="{{this.prepareState}}"{{/if}}>
            <div class="panel-item-row">
                <div class="panel-item-image-container">
                    <img draggable="false" class="panel-item-image" src="{{this.img}}" alt="{{this.name}}"/>
                    <i class="fa-solid fa-dice-d20 squire-roll-overlay panel-item-roll-overlay"></i>
                </div>
                <div class="panel-item-name">
                    <span class="panel-item-label">{{this.name}}</span>
                    {{~#if this.isNew}}<span class="new-tag">NEW</span>{{/if~}}
                    {{!-- Kind and weight. Drawn only by the tile layout, which
                          hides the rest of the row's context behind a clipped
                          two-line name; the list has the whole panel width and
                          does not need telling that a longsword is a weapon. --}}
                    <span class="panel-item-detail">{{this.detailLabel}}</span>
                    {{#if this.showContext}}
                    <span class="panel-item-context">
                        {{> action-badge actionType=this.actionType}}
                        {{#if this.canEditQuantity}}
                        <span class="panel-item-badge context-count editable" data-quantity-edit title="Quantity — click to edit, 0 removes the item">x{{this.system.quantity}}</span>
                        {{/if}}
                    </span>
                    {{/if}}
                </div>
                <div class="tray-buttons">
                    {{#if this.statblockIssue}}
                    <i class="fa-solid fa-triangle-exclamation statblock-warning {{#unless this.statblockIssue.canFix}}no-fix{{/unless}}" data-tooltip="{{{this.statblockIssue.tooltip}}}"></i>
                    {{/if}}
                    {{#if this.isLightSource}}
                    <i class="fa-solid fa-lightbulb {{#unless this.isLightActive}}faded{{/unless}} {{#if this.isLightActive}}light-active{{/if}}" title="Toggle Light"></i>
                    {{/if}}
                    {{#if this.container}}
                    <i class="fa-solid fa-sack item-container-open" data-container-id="{{this.container.id}}" data-tooltip="Stored in <strong>{{this.container.name}}</strong><br><em>Click to open</em>"></i>
                    {{/if}}
                    {{#if (eq this.type 'spell')}}
                    <i class="fa-solid fa-sun {{#unless this.isPrepared}}faded{{/unless}}" title="Prepared"></i>
                    {{else if (eq this.type 'feat')}}
                    <i class="fa-solid fa-stars" title="Always Available"></i>
                    {{else if (or (eq this.type 'weapon') (eq this.type 'equipment') (eq this.type 'consumable') (eq this.type 'tool') (eq this.type 'loot'))}}
                    <i class="fa-solid fa-shield-alt {{#unless this.system.equipped}}faded{{/unless}}" title="Equipped"></i>
                    {{/if}}
                    <i class="fa-solid fa-heart" title="Remove from Favorites"></i>
                    <i class="fa-solid fa-feather"></i>
                </div>
            </div>
        </div>
        {{/each}}
        {{/each}}
        {{else}}
        <div class="tray-title-small" style="text-align: center; padding: 10px;">No favorites available</div>
        {{/if}}
    </div>
</div> 

