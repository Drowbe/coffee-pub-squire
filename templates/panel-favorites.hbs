<div class="favorites-panel">
<div class="section-header">
    <div class="header-left">
        <i class="fa-solid fa-heart"></i> Favorites
    </div>
    <div class="header-right">
        {{#if hasFavorites}}
        <i class="fa-solid fa-heart-circle-xmark favorites-clear-all" title="Clear All Favorites"></i>
        {{/if}}
    </div>
</div>

    <div class="favorites-list">
        {{#if favorites}}
        {{#each favorites}}
        <div draggable="true" class="panel-item" 
             data-item-id="{{this.id}}" data-item-type="{{this.type}}"
             data-action-types="{{this.actionTypes}}"{{#if this.equipState}}
             data-equip-state="{{this.equipState}}"{{/if}}{{#if this.prepareState}}
             data-prepare-state="{{this.prepareState}}"{{/if}}>
            <div class="panel-item-row">
                <div class="panel-item-image-container">
                    <img draggable="false" class="panel-item-image" src="{{this.img}}" alt="{{this.name}}"/>
                    <i class="fa-solid fa-dice-d20 panel-item-roll-overlay"></i>
                </div>
                <div class="panel-item-name">
                    <span class="panel-item-label">{{this.name}}</span>
                    {{#if this.isNew}}<span class="new-tag">NEW</span>{{/if}}
                    {{#if this.showContext}}
                    <span class="panel-item-context">
                        {{> action-badge actionType=this.actionType}}
                        {{#if this.canEditQuantity}}
                        <span class="panel-item-badge context-count editable" data-quantity-edit title="Quantity — click to edit, 0 removes the item">x{{this.system.quantity}}</span>
                        {{/if}}
                    </span>
                    {{/if}}
                </div>
                <div class="tray-buttons">
                    {{#if this.statblockIssue}}
                    <i class="fa-solid fa-triangle-exclamation statblock-warning {{#unless this.statblockIssue.canFix}}no-fix{{/unless}}" data-tooltip="{{{this.statblockIssue.tooltip}}}"></i>
                    {{/if}}
                    {{#if this.isLightSource}}
                    <i class="fa-solid fa-lightbulb {{#unless this.isLightActive}}faded{{/unless}} {{#if this.isLightActive}}light-active{{/if}}" title="Toggle Light"></i>
                    {{/if}}
                    {{#if this.container}}
                    <i class="fa-solid fa-sack item-container-open" data-container-id="{{this.container.id}}" data-tooltip="Stored in <strong>{{this.container.name}}</strong><br><em>Click to open</em>"></i>
                    {{/if}}
                    {{#if (eq this.type 'spell')}}
                    <i class="fa-solid fa-sun {{#unless this.isPrepared}}faded{{/unless}}" title="Prepared"></i>
                    {{else if (eq this.type 'feat')}}
                    <i class="fa-solid fa-stars" title="Always Available"></i>
                    {{else if (or (eq this.type 'weapon') (eq this.type 'equipment') (eq this.type 'consumable') (eq this.type 'tool') (eq this.type 'loot'))}}
                    <i class="fa-solid fa-shield-alt {{#unless this.system.equipped}}faded{{/unless}}" title="Equipped"></i>
                    {{/if}}
                    <i class="fa-solid fa-dagger handle-favorite-toggle {{#unless this.isHandleFavorite}}faded{{/unless}}" title="Toggle Handle Favorite"></i>
                    <i class="fa-solid fa-heart" title="Remove from Favorites"></i>
                    <i class="fa-solid fa-feather"></i>
                </div>
            </div>
        </div>
        {{/each}}
        <div class="tray-title-small no-matches" style="text-align: center; padding: 10px; display: none;">No matches found</div>
        {{else}}
        <div class="tray-title-small" style="text-align: center; padding: 10px;">No favorites available</div>
        {{/if}}
    </div>
</div> 

