{{!--
    The paper doll. Two grids: the body around the portrait, and the weapons in
    a row of thirds beneath it.

    Every slot is the same markup whether it is empty, filled or broken — the
    state is classes and content, not three branches, because a drop target that
    changes shape as it fills is a drop target that moves under the cursor.
--}}
<div class="squire-build">


    {{!-- The rail: every build this character has, and the only place they are
          managed. It replaced a section in the tray, which spent a lot of a
          narrow column on something touched rarely — and split one feature in
          two, since editing happened here and applying happened there.

          Entries drag onto the tray handle, which is how a build gets somewhere
          reachable with the tray shut. --}}
    <div class="squire-build-rail">
        <div class="squire-build-rail-list">
            {{#each rail}}
            <div class="squire-build-rail-entry{{#if this.active}} is-active{{/if}}"
                 draggable="true" data-build-id="{{this.id}}"
                 data-tooltip="{{this.name}}<br><em>Drag onto the tray handle to keep it to hand</em><br><em>Right-click for more</em>">
                <div class="squire-build-rail-head">
                    <span class="squire-build-rail-name">{{this.name}}</span>
                    <button type="button" class="squire-build-rail-apply" data-build-id="{{this.id}}"
                            data-tooltip="Equip this build">
                        <i class="fa-solid fa-person-running"></i>
                    </button>
                </div>
                <div class="squire-build-rail-preview">
                    {{#each this.preview}}
                    <img src="{{this.img}}" alt="{{this.name}}">
                    {{/each}}
                </div>
                <div class="squire-build-rail-stats">
                    <span><i class="fa-solid fa-shield"></i> {{this.armorClass}}</span>
                    <span><i class="fa-solid fa-shirt"></i> {{this.gearCount}}</span>
                </div>
            </div>
            {{/each}}
        </div>

        <button type="button" class="squire-build-rail-new">
            <i class="fa-solid fa-plus"></i> New Build
        </button>
    </div>

    <div class="squire-build-workspace">
    {{#if hasBuilds}}
    {{!-- The name reads as a heading and edits as a field. It was a full-width
          boxed input, which made the least important thing in the window the
          biggest — it only needs to be reachable, not announced. --}}
    <input type="text" class="squire-build-name" value="{{build.name}}"
           maxlength="60" spellcheck="false" aria-label="Build name">

    <div class="squire-build-columns">
    <div class="squire-build-doll">
    <div class="squire-build-body">
        {{#each bodySlots}}
        <div class="squire-build-slot{{#if this.round}} is-round{{/if}}{{#if this.filled}} is-filled{{/if}}{{#if this.missing}} is-missing{{/if}}"
             data-rarity="{{this.rarity}}"
             style="grid-row: {{this.row}}; grid-column: {{this.column}};"
             data-slot="{{this.key}}"{{#if this.uuid}} data-item-uuid="{{this.uuid}}"{{/if}}
             data-tooltip="{{#if this.filled}}{{this.name}}<br><em>Right-click to clear</em>{{else if this.missing}}This item is no longer on the sheet<br><em>Right-click to clear</em>{{else}}{{this.label}} — drag an item here{{/if}}">
            {{#if this.filled}}
            {{!-- Drawn like a favourites tile: the artwork IS the slot, with the
                  name over the bottom of it under a gradient. Same reasoning as
                  there — a caption panel becomes a band of colour across every
                  slot, and a text shadow vanishes on a pale icon. --}}
            <img class="squire-build-slot-image" src="{{this.img}}" alt="{{this.name}}">
            {{!-- The slot's own glyph, kept in the corner once the artwork has
                  covered the label. A full doll is otherwise sixteen pictures
                  with no way to tell which hole each one is filling. --}}
            <i class="fa-solid {{this.icon}} squire-build-slot-hint"></i>
            {{!-- Attunement, as a gem in the corner. Lit when attuned, hollow and
                  warned when the item requires it and has not got it — the
                  second is the one worth seeing, because that item will do
                  nothing when the build is worn. --}}
            {{#if this.attuned}}
            <i class="fa-solid fa-gem squire-build-attunement is-attuned"></i>
            {{else if this.needsAttunement}}
            <i class="fa-regular fa-gem squire-build-attunement is-unattuned"></i>
            {{/if}}
            <span class="squire-build-slot-name">{{this.name}}</span>
            {{else if this.missing}}
            <i class="fa-solid fa-triangle-exclamation squire-build-slot-icon is-warning"></i>
            <span class="squire-build-slot-label">{{this.label}}</span>
            {{else}}
            <i class="fa-solid {{this.icon}} squire-build-slot-icon"></i>
            <span class="squire-build-slot-label">{{this.label}}</span>
            {{/if}}
        </div>
        {{/each}}

        {{!-- Portrait and token, flanking the head. Not gear: these hold an image
              path, not an item, so they take a click rather than a drop. Round,
              like the ammo slots, because a circle marks "different kind of
              thing" without spending a word. --}}
        {{#each imageSlots}}
        <div class="squire-build-slot is-round squire-build-image-slot{{#unless this.isDefault}} is-set{{/unless}}"
             style="grid-row: {{this.row}}; grid-column: {{this.column}};"
             data-image="{{this.key}}"
             data-tooltip="{{this.label}}{{#if this.isDefault}} — currently the character's own<br><em>Click to choose an image</em>{{else}}<br><em>Click to change, right-click to reset</em>{{/if}}">
            {{#if this.path}}
            <img class="squire-build-slot-image" src="{{this.path}}" alt="{{this.label}}">
            {{/if}}
            <i class="fa-solid {{this.icon}} squire-build-slot-hint"></i>
        </div>
        {{/each}}

        {{!-- The portrait, filling the middle of the doll. Not a slot and not
              droppable: it is there so the ring of slots reads as a body rather
              than as a scattered grid. --}}
        <div class="squire-build-portrait" style="grid-row: 2 / 5; grid-column: 2 / 5;">
            <img src="{{actorImg}}" alt="{{actorName}}">

            {{!-- The armour class, big, on the portrait's hem — where Baldur's
                  Gate puts it, and for the same reason: it is the number you are
                  actually playing against, and it belongs on the character
                  rather than in a line of footnotes.

                  It updates live while an item hovers a slot, which is why the
                  value and the delta are separate elements the window can write
                  to without re-rendering. --}}
            <div class="squire-build-ac-badge"
                 data-tooltip="Estimated from this build's armour, shield and Dexterity.<br>Class features, fighting styles and active effects are <strong>not</strong> counted, so this is for comparing builds rather than for your sheet.">
                <i class="fa-solid fa-shield squire-build-ac-badge-shield"></i>
                <span class="squire-build-ac-badge-value">{{armorClass.value}}</span>
                <span class="squire-build-ac-badge-label">AC est.</span>
                <span class="squire-build-ac-badge-delta" hidden></span>
            </div>
        </div>
    </div>

    <div class="squire-build-weapons">
        {{#each weaponSlots}}
        <div class="squire-build-slot{{#if this.filled}} is-filled{{/if}}{{#if this.missing}} is-missing{{/if}}"
             data-rarity="{{this.rarity}}"
             data-slot="{{this.key}}"{{#if this.uuid}} data-item-uuid="{{this.uuid}}"{{/if}}
             data-tooltip="{{#if this.filled}}{{this.name}}<br><em>Right-click to clear</em>{{else if this.missing}}This item is no longer on the sheet<br><em>Right-click to clear</em>{{else}}{{this.label}} — drag an item here{{/if}}">
            {{#if this.filled}}
            {{!-- Drawn like a favourites tile: the artwork IS the slot, with the
                  name over the bottom of it under a gradient. Same reasoning as
                  there — a caption panel becomes a band of colour across every
                  slot, and a text shadow vanishes on a pale icon. --}}
            <img class="squire-build-slot-image" src="{{this.img}}" alt="{{this.name}}">
            {{!-- The slot's own glyph, kept in the corner once the artwork has
                  covered the label. A full doll is otherwise sixteen pictures
                  with no way to tell which hole each one is filling. --}}
            <i class="fa-solid {{this.icon}} squire-build-slot-hint"></i>
            {{!-- Attunement, as a gem in the corner. Lit when attuned, hollow and
                  warned when the item requires it and has not got it — the
                  second is the one worth seeing, because that item will do
                  nothing when the build is worn. --}}
            {{#if this.attuned}}
            <i class="fa-solid fa-gem squire-build-attunement is-attuned"></i>
            {{else if this.needsAttunement}}
            <i class="fa-regular fa-gem squire-build-attunement is-unattuned"></i>
            {{/if}}
            <span class="squire-build-slot-name">{{this.name}}</span>
            {{else if this.missing}}
            <i class="fa-solid fa-triangle-exclamation squire-build-slot-icon is-warning"></i>
            <span class="squire-build-slot-label">{{this.label}}</span>
            {{else}}
            <i class="fa-solid {{this.icon}} squire-build-slot-icon"></i>
            <span class="squire-build-slot-label">{{this.label}}</span>
            {{/if}}
        </div>
        {{/each}}
    </div>

    {{!-- Says what this window is FOR, because nothing else in it does. A grid of
          empty boxes beside a portrait invites the reading that these are slots
          the character is currently wearing. --}}
    </div>

    {{#if casters}}
    {{!-- The caster's half. One section per class that PREPARES: a Cleric 5 /
          Wizard 3 has two independent limits and two lists, and one combined
          number would be flatly wrong. A known caster — sorcerer, bard, warlock —
          has no preparation maximum, so no section appears rather than an empty
          one; their list is not a daily choice. --}}
    <div class="squire-build-spells">
        {{#each casters}}
        <div class="squire-build-caster">
            <div class="squire-build-caster-header">
                <span class="squire-build-caster-name">{{this.name}}</span>
                <span class="squire-build-caster-count">{{this.used}} / {{this.max}} prepared</span>
            </div>
            <div class="squire-build-spell-grid">
                {{#each this.slots}}
                <div class="squire-build-spell-slot{{#if this.filled}} is-filled{{/if}}{{#if this.missing}} is-missing{{/if}}"
                     data-spell-class="{{../id}}" data-spell-index="{{this.index}}"{{#if this.uuid}} data-item-uuid="{{this.uuid}}"{{/if}}
                     data-tooltip="{{#if this.filled}}{{this.name}}<br><em>Right-click to clear</em>{{else if this.missing}}This spell is no longer on the sheet<br><em>Right-click to clear</em>{{else}}Drag a spell here{{/if}}">
                    {{#if this.filled}}
                    <img class="squire-build-slot-image" src="{{this.img}}" alt="{{this.name}}">
                    {{#if this.concentration}}
                    <i class="fa-solid fa-circle-c squire-build-concentration"
                       data-tooltip="Concentration"></i>
                    {{/if}}
                    <span class="squire-build-spell-level">{{this.level}}</span>
                    <span class="squire-build-slot-name">{{this.name}}</span>
                    {{else if this.missing}}
                    <i class="fa-solid fa-triangle-exclamation squire-build-slot-icon is-warning"></i>
                    {{else}}
                    <i class="fa-solid fa-sparkles squire-build-slot-icon"></i>
                    {{/if}}
                </div>
                {{/each}}
            </div>
        </div>
        {{/each}}

        {{!-- Cantrips are a READOUT, not slots. They are always available, so
              they are not part of a daily plan and there is nothing to choose;
              showing them beside the prepared list says what else is on hand. --}}
        {{#if cantrips}}
        <div class="squire-build-readout">
            <div class="squire-build-readout-label">Cantrips</div>
            <div class="squire-build-cantrips">
                {{#each cantrips}}
                <img class="squire-build-cantrip" src="{{this.img}}" alt="{{this.name}}" data-tooltip="{{this.name}}">
                {{/each}}
            </div>
        </div>
        {{/if}}

        {{!-- The slot pyramid, also a readout. It is what tells you whether a
              prepared list is castable; it is not a set of containers, because
              a prepared spell is not assigned to a slot in this game. --}}
        {{#if spellSlots}}
        <div class="squire-build-readout">
            <div class="squire-build-readout-label">Slots</div>
            <div class="squire-build-slot-ranks">
                {{#each spellSlots}}
                <span class="squire-build-rank" data-tooltip="{{this.label}} level: {{this.value}} of {{this.max}} remaining">
                    <span class="squire-build-rank-label">{{this.label}}</span>
                    <span class="squire-build-rank-pips">{{this.max}}</span>
                </span>
                {{/each}}
            </div>
        </div>
        {{/if}}
    </div>
    {{/if}}
    </div>

    {{!-- The one number this window can give you that counting by hand would not:
          attunement is the constraint that makes a build a puzzle rather than a
          list, and it is invisible on the sheet until you total it up. --}}
    <div class="squire-build-summary">
        <span class="squire-build-attunement-count{{#if attunement.over}} is-over{{/if}}"
              data-tooltip="Attunement slots this build would use{{#if attunement.over}}<br><strong>More than this character has</strong>{{/if}}">
            <i class="fa-solid fa-gem"></i> {{attunement.used}} / {{attunement.max}} attuned
        </span>
        <span class="squire-build-weight" data-tooltip="What the gear in this build weighs. Prepared spells are not included, and a slotted stack counts once.">
            <i class="fa-solid fa-weight-hanging"></i> <span class="squire-build-weight-value">{{#if weight}}{{weight}}{{else}}0{{/if}}</span> lb
        </span>
        {{#if attunement.unattuned}}
        <span class="squire-build-attunement-warning"
              data-tooltip="These items require attunement and have not got it, so they would do nothing.">
            <i class="fa-solid fa-triangle-exclamation"></i> {{attunement.unattuned}} needs attunement
        </span>
        {{/if}}
    </div>
    {{else}}
    <div class="squire-empty-message squire-build-empty">
        <p>- No Builds Yet -</p>
        <p>Use New Build to start one</p>
    </div>
    {{/if}}

    {{!-- Says what this window is FOR, because nothing else in it does. A grid of
          slots beside a portrait invites the reading that these ARE the
          character's current gear, and editing here still changes nothing until
          the build is equipped from its tile. --}}
    <p class="squire-build-note">
        A plan. Nothing changes on the sheet until you equip it.
    </p>
    </div>
</div>
