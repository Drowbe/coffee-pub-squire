{{!--
    The paper doll. Two grids: the body around the portrait, and the weapons in
    a row of thirds beneath it.

    Every slot is the same markup whether it is empty, filled or broken — the
    state is classes and content, not three branches, because a drop target that
    changes shape as it fills is a drop target that moves under the cursor.
--}}
<div class="squire-build">


    {{!-- The rail: every build this character has, and the only place they are
          managed. It replaced a section in the tray, which spent a lot of a
          narrow column on something touched rarely — and split one feature in
          two, since editing happened here and applying happened there.

          Entries drag onto the tray handle, which is how a build gets somewhere
          reachable with the tray shut. --}}
    <div class="squire-build-rail">
        <div class="squire-build-rail-list">
            {{#each rail}}
            {{!-- A tile, not a row: the build's own picture is its face, the way
                  a favourite's artwork is. The gear thumbnails that used to sit
                  here said what was IN the build, which the doll shows in full
                  the moment it is selected — and five item icons at 20px is a
                  row of smudges rather than a summary. The portrait and token
                  are the marks instead: what wearing it would make you look
                  like, which is the thing the doll does NOT show. --}}
            <div class="squire-build-rail-entry{{#if this.active}} is-active{{/if}}"
                 draggable="true" data-build-id="{{this.id}}"
                 style="background-image: linear-gradient(rgba(8,6,4,.55), rgba(8,6,4,.88)), url('{{this.mainImage}}');"
                 data-tooltip="{{this.name}}<br><em>Drag onto the tray handle to keep it to hand</em><br><em>Right-click for more</em>">
                <div class="squire-build-rail-head">
                    <span class="squire-build-rail-name">{{this.name}}</span>
                    <button type="button" class="squire-build-rail-apply" data-build-id="{{this.id}}"
                            data-tooltip="Equip this build">
                        <i class="fa-solid fa-person-running"></i>
                    </button>
                </div>
                <div class="squire-build-rail-preview">
                    {{#if this.portrait}}<img src="{{this.portrait}}" alt="Portrait" data-tooltip="Portrait">{{/if}}
                    {{#if this.token}}<img src="{{this.token}}" alt="Token" data-tooltip="Token">{{/if}}
                    {{#if this.mainHand}}<img class="is-gear" src="{{this.mainHand}}" alt="{{this.mainHandName}}" data-tooltip="{{this.mainHandName}}">{{/if}}
                </div>
                <div class="squire-build-rail-stats">
                    {{#unless this.costume}}
                    <span><i class="fa-solid fa-shield"></i> {{this.armorClass}}</span>
                    <span><i class="fa-solid fa-shirt"></i> {{this.gearCount}}</span>
                    {{else}}
                    <span><i class="fa-solid fa-masks-theater"></i> Costume</span>
                    {{/unless}}
                    {{#if this.worn}}
                    {{!-- Selected is what this window is showing; WORN is what
                          the character actually has on. The rail is the only
                          place both facts are visible at once. --}}
                    <span class="squire-build-rail-worn" data-tooltip="This is what the character is currently wearing">
                        <i class="fa-solid fa-check"></i> Worn
                    </span>
                    {{/if}}
                </div>
            </div>
            {{/each}}
        </div>

        {{!-- Two buttons, not one and a switch. You know which of the two you
              are setting out to make before you start; the switch beside the
              name is for changing your mind afterwards. --}}
        <div class="squire-build-rail-actions">
            <button type="button" class="squire-build-rail-new" data-mode="gear"
                    data-tooltip="A set of gear to equip">
                <i class="fa-solid fa-plus"></i> Build
            </button>
            <button type="button" class="squire-build-rail-new" data-mode="costume"
                    data-tooltip="A portrait and token to wear. Changes how the character LOOKS and touches no gear.">
                <i class="fa-solid fa-masks-theater"></i> Costume
            </button>
        </div>

        {{!-- Options that belong to BUILDS, not to any one build. The rail is
              where they go for the same reason the list is: it is the part of
              this window that is about the whole feature rather than the thing
              currently on the doll. --}}
        <div class="squire-build-rail-global">
            <div class="squire-build-rail-global-label">Options</div>
            <div class="blacksmith-toggle-row squire-build-rail-option"
                 data-tooltip="Equipping a build also puts its Main Hand, Both Hands and Off Hand weapons on the tray handle, replacing whatever the last build put there. Items you dragged onto the handle yourself are never touched.">
                <span class="blacksmith-toggle-label">Weapons on handle</span>
                <label class="blacksmith-toggle">
                    <input type="checkbox" class="blacksmith-toggle-input squire-build-handle-input"
                           {{#if updatesHandle}}checked{{/if}}>
                    <span class="blacksmith-toggle-slider"></span>
                </label>
            </div>
        </div>
    </div>

    <div class="squire-build-workspace">
    {{#if hasBuilds}}
    {{!-- ONE grid for the whole workspace, in both modes and for both kinds of
          character. The title is a row of it rather than a band above it, so it
          stops where the doll stops and the rule beside it runs the full height
          the way the rail's does. Its second row is pinned to the doll's height,
          which is what makes a costume and a build the same size — and what
          stops toggling between them resizing the window. --}}
    <div class="squire-build-columns{{#if isCaster}}{{#unless isCostume}} has-pack{{/unless}}{{/if}}">

    {{!-- The name reads as a heading and edits as a field. It was a full-width
          boxed input, which made the least important thing in the window the
          biggest — it only needs to be reachable, not announced. --}}
    <div class="squire-build-title-row">
        <input type="text" class="squire-build-name" value="{{build.name}}"
               maxlength="60" spellcheck="false" aria-label="Build name">

        {{!-- Build or Costume. A costume changes only the portrait and token and
              leaves gear and spells alone — which is not the same as a build
              with empty slots, because applying THAT would strip the character
              bare. Two labelled halves rather than a checkbox: this decides what
              a apply does, and "what will this do" should never be a state you
              read off a tick. --}}
        <div class="blacksmith-toggle-row squire-build-mode"
             data-tooltip="<strong>Build</strong> equips the gear and prepares the spells.<br><strong>Costume</strong> changes only the portrait and token and leaves gear and spells alone.">
            <span class="blacksmith-toggle-label{{#unless (eq build.mode 'costume')}} is-active{{/unless}}">Build</span>
            <label class="blacksmith-toggle">
                <input type="checkbox" class="blacksmith-toggle-input squire-build-mode-input"
                       {{#if (eq build.mode 'costume')}}checked{{/if}}>
                <span class="blacksmith-toggle-slider"></span>
            </label>
            <span class="blacksmith-toggle-label{{#if (eq build.mode 'costume')}} is-active{{/if}}">Costume</span>
        </div>
    </div>

    {{#if isCaster}}{{#unless isCostume}}
    {{!-- The rule between the doll and the column, mirroring the one between the
          rail and the workspace. Its own track rather than a border on either
          side: a border would eat into whichever column carried it, and the
          whole layout rests on those two being exact multiples of each other.
          It spans both rows, so it runs past the title to the top.

          Not in costume mode: there is no second column there to divide, and a
          rule with nothing on the far side of it is just a line. --}}
    <div class="squire-build-divider"></div>
    {{/unless}}{{/if}}

    {{#if isCostume}}
    {{!-- A costume is three pictures and a name. The doll is not hidden here so
          much as absent: a costume never touches gear or spells, so sixteen
          slots that can only sit empty would be a promise the mode does not
          make — and the plates, the armour class and the spell column all
          describe equipment this view has nothing to do with. --}}
    <div class="squire-build-costume">
        {{!-- The two images this costume WRITES, side by side at the top, and the
              costume's own picture filling everything under them.

              They were stacked around the picture, one above and one below, and
              that spent the column's height on three rows so all three had to be
              small. Together on one row they cost a single row between them and
              the square below gets the rest. --}}
        <div class="squire-build-costume-pair">
            {{#with portraitSlot}}
            <div class="squire-build-costume-image">
                <div class="squire-build-slot is-round squire-build-image-slot{{#unless this.isDefault}} is-set{{/unless}}"
                     data-image="{{this.key}}"
                     data-tooltip="{{#if this.isDefault}}This costume does not change the {{this.label}} — wearing it leaves the character's own alone<br><em>Click to choose an image</em>{{else}}Wearing this costume sets the {{this.label}}<br><em>Click to change, right-click to reset</em>{{/if}}">
                    {{#if this.path}}
                    <img class="squire-build-slot-image" src="{{this.path}}" alt="{{this.label}}">
                    {{/if}}
                    <i class="fa-solid {{this.icon}} squire-build-slot-hint"></i>
                    {{#if this.isDefault}}
                    <span class="squire-build-image-unset">no change</span>
                    {{/if}}
                </div>
                <span class="squire-build-costume-label">{{this.label}}</span>
            </div>
            {{/with}}
            {{#with tokenSlot}}
            <div class="squire-build-costume-image">
                <div class="squire-build-slot is-round squire-build-image-slot{{#unless this.isDefault}} is-set{{/unless}}"
                     data-image="{{this.key}}"
                     data-tooltip="{{#if this.isDefault}}This costume does not change the {{this.label}} — wearing it leaves the character's own alone<br><em>Click to choose an image</em>{{else}}Wearing this costume sets the {{this.label}}<br><em>Click to change, right-click to reset</em>{{/if}}">
                    {{#if this.path}}
                    <img class="squire-build-slot-image" src="{{this.path}}" alt="{{this.label}}">
                    {{/if}}
                    <i class="fa-solid {{this.icon}} squire-build-slot-hint"></i>
                    {{#if this.isDefault}}
                    <span class="squire-build-image-unset">no change</span>
                    {{/if}}
                </div>
                <span class="squire-build-costume-label">{{this.label}}</span>
            </div>
            {{/with}}
        </div>

        <div class="squire-build-costume-main squire-build-image-slot{{#unless mainImage.isDefault}} is-set{{/unless}}"
             data-image="main"
             data-tooltip="{{#if mainImage.isDefault}}This costume has no picture of its own<br><em>Click to choose one</em>{{else}}Costume image<br><em>Click to change, right-click to reset</em>{{/if}}">
            <img src="{{mainImage.path}}" alt="{{build.name}}">
            {{#if mainImage.isDefault}}
            <span class="squire-build-image-unset">no change</span>
            {{/if}}
        </div>
    </div>
    {{/if}}
    {{#unless isCostume}}
    <div class="squire-build-doll">
    <div class="squire-build-body">
        {{#each bodySlots}}
        <div class="squire-build-slot{{#if this.round}} is-round{{/if}}{{#if this.filled}} is-filled{{/if}}{{#if this.missing}} is-missing{{/if}}"
             data-rarity="{{this.rarity}}"
             style="grid-row: {{this.row}}; grid-column: {{this.column}};"
             data-slot="{{this.key}}"{{#if this.uuid}} data-item-uuid="{{this.uuid}}"{{/if}}
             data-tooltip="{{#if this.filled}}{{this.name}}<br><em>Right-click to clear</em>{{else if this.missing}}This item is no longer on the sheet<br><em>Right-click to clear</em>{{else}}{{this.label}} — drag an item here{{/if}}">
            {{#if this.filled}}
            {{!-- Drawn like a favourites tile: the artwork IS the slot, with the
                  name over the bottom of it under a gradient. Same reasoning as
                  there — a caption panel becomes a band of colour across every
                  slot, and a text shadow vanishes on a pale icon. --}}
            <img class="squire-build-slot-image" src="{{this.img}}" alt="{{this.name}}">
            {{!-- The slot's own glyph, kept in the corner once the artwork has
                  covered the label. A full doll is otherwise sixteen pictures
                  with no way to tell which hole each one is filling. --}}
            <i class="fa-solid {{this.icon}} squire-build-slot-hint"></i>
            {{!-- Attunement, as a gem in the corner. Lit when attuned, hollow and
                  warned when the item requires it and has not got it — the
                  second is the one worth seeing, because that item will do
                  nothing when the build is worn. --}}
            {{#if this.attuned}}
            <i class="fa-solid fa-gem squire-build-attunement is-attuned"></i>
            {{else if this.needsAttunement}}
            <i class="fa-regular fa-gem squire-build-attunement is-unattuned"></i>
            {{/if}}
            <span class="squire-build-slot-name">{{this.name}}</span>
            {{else if this.missing}}
            <i class="fa-solid fa-triangle-exclamation squire-build-slot-icon is-warning"></i>
            <span class="squire-build-slot-label">{{this.label}}</span>
            {{else}}
            <i class="fa-solid {{this.icon}} squire-build-slot-icon"></i>
            <span class="squire-build-slot-label">{{this.label}}</span>
            {{/if}}
        </div>
        {{/each}}

        {{!-- Portrait and token, flanking the head. Not gear: these hold an image
              path, not an item, so they take a click rather than a drop. Round,
              like the ammo slots, because a circle marks "different kind of
              thing" without spending a word. --}}
        {{#each imageSlots}}
        <div class="squire-build-slot is-round squire-build-image-slot{{#unless this.isDefault}} is-set{{/unless}}"
             style="grid-row: {{this.row}}; grid-column: {{this.column}};"
             data-image="{{this.key}}"
             data-tooltip="{{this.label}}{{#if this.isDefault}} — this build does not change it, so the character's own stays<br><em>Click to choose an image</em>{{else}} — this build sets it when applied<br><em>Click to change, right-click to reset</em>{{/if}}">
            {{#if this.path}}
            <img class="squire-build-slot-image" src="{{this.path}}" alt="{{this.label}}">
            {{/if}}
            <i class="fa-solid {{this.icon}} squire-build-slot-hint"></i>
            {{!-- An unset slot shows the character's CURRENT artwork, which made
                  it look chosen when it was not — and a build only writes the
                  images it actually sets, so an unset portrait silently changes
                  nothing on apply. The dashed border said that already; this
                  says it in a word. --}}
            {{#if this.isDefault}}
            <span class="squire-build-image-unset">no change</span>
            {{/if}}
        </div>
        {{/each}}

        {{!-- The portrait, filling the middle of the doll. Not a slot and not
              droppable: it is there so the ring of slots reads as a body rather
              than as a scattered grid. --}}
        {{!-- The build's own picture. Browsed for like the portrait and the token,
              and unlike them it is never written to the character — a costume
              changes `actor.img`, and the centre of the doll is the one thing in
              this window that should hold still while the outfits change.
              Unset, it falls back through the build's portrait to the
              character's captured artwork. --}}
        <div class="squire-build-portrait squire-build-image-slot{{#unless mainImage.isDefault}} is-set{{/unless}}"
             style="grid-row: 2 / 5; grid-column: 2 / 5;"
             data-image="main"
             data-tooltip="{{#if mainImage.isDefault}}This build has no picture of its own<br><em>Click to choose one</em>{{else}}Build image<br><em>Click to change, right-click to reset</em>{{/if}}">
            <img src="{{mainImage.path}}" alt="{{actorName}}">
            {{#if mainImage.isDefault}}
            <span class="squire-build-image-unset">no change</span>
            {{/if}}

            {{!-- The armour class, big, on the portrait's hem — where Baldur's
                  Gate puts it, and for the same reason: it is the number you are
                  actually playing against, and it belongs on the character
                  rather than in a line of footnotes.

                  It updates live while an item hovers a slot, which is why the
                  value and the delta are separate elements the window can write
                  to without re-rendering. --}}
            <div class="squire-build-ac-badge"
                 data-tooltip="Estimated from this build's armour, shield and Dexterity.<br>Class features, fighting styles and active effects are <strong>not</strong> counted, so this is for comparing builds rather than for your sheet.">
                <i class="fa-solid fa-shield squire-build-ac-badge-shield"></i>
                <span class="squire-build-ac-badge-value">{{armorClass.value}}</span>
                <span class="squire-build-ac-badge-label">AC</span>
                <span class="squire-build-ac-badge-delta" hidden></span>
            </div>

            {{!-- The totals, as plates on the portrait rather than a line of text
                  under everything. They describe the figure, so they belong on
                  it — and the armour class was already proving that the corners
                  of a portrait are the most readable place in this window. --}}
            <div class="squire-build-plate squire-build-plate-attunement{{#if attunement.over}} is-over{{/if}}"
                 data-tooltip="Attunement slots this build would use, out of what this character has.{{#if attunement.over}}<br><strong>This build needs more than they have.</strong>{{/if}}">
                <i class="fa-solid fa-gem"></i>
                <span>{{attunement.used}}/{{attunement.max}}</span>
            </div>

            <div class="squire-build-plate squire-build-plate-weight"
                 data-tooltip="What this build's gear weighs. Prepared spells are not counted, and a slotted stack counts once.">
                <i class="fa-solid fa-weight-hanging"></i>
                <span class="squire-build-weight-value">{{#if weight}}{{weight}}{{else}}0{{/if}}</span>
            </div>

            {{#if attunement.unattuned}}
            <div class="squire-build-plate squire-build-plate-warning"
                 data-tooltip="{{attunement.unattuned}} item{{#unless (eq attunement.unattuned 1)}}s{{/unless}} in this build require attunement and have not got it, so they would do nothing.">
                <i class="fa-solid fa-triangle-exclamation"></i>
                <span>{{attunement.unattuned}}</span>
            </div>
            {{/if}}
        </div>
    </div>

    <div class="squire-build-weapons">
        {{#each weaponSlots}}
        <div class="squire-build-slot{{#if this.filled}} is-filled{{/if}}{{#if this.missing}} is-missing{{/if}}"
             data-rarity="{{this.rarity}}"
             data-slot="{{this.key}}"{{#if this.uuid}} data-item-uuid="{{this.uuid}}"{{/if}}
             data-tooltip="{{#if this.filled}}{{this.name}}<br><em>Right-click to clear</em>{{else if this.missing}}This item is no longer on the sheet<br><em>Right-click to clear</em>{{else}}{{this.label}} — drag an item here{{/if}}">
            {{#if this.filled}}
            {{!-- Drawn like a favourites tile: the artwork IS the slot, with the
                  name over the bottom of it under a gradient. Same reasoning as
                  there — a caption panel becomes a band of colour across every
                  slot, and a text shadow vanishes on a pale icon. --}}
            <img class="squire-build-slot-image" src="{{this.img}}" alt="{{this.name}}">
            {{!-- The slot's own glyph, kept in the corner once the artwork has
                  covered the label. A full doll is otherwise sixteen pictures
                  with no way to tell which hole each one is filling. --}}
            <i class="fa-solid {{this.icon}} squire-build-slot-hint"></i>
            {{!-- Attunement, as a gem in the corner. Lit when attuned, hollow and
                  warned when the item requires it and has not got it — the
                  second is the one worth seeing, because that item will do
                  nothing when the build is worn. --}}
            {{#if this.attuned}}
            <i class="fa-solid fa-gem squire-build-attunement is-attuned"></i>
            {{else if this.needsAttunement}}
            <i class="fa-regular fa-gem squire-build-attunement is-unattuned"></i>
            {{/if}}
            <span class="squire-build-slot-name">{{this.name}}</span>
            {{else if this.missing}}
            <i class="fa-solid fa-triangle-exclamation squire-build-slot-icon is-warning"></i>
            <span class="squire-build-slot-label">{{this.label}}</span>
            {{else}}
            <i class="fa-solid {{this.icon}} squire-build-slot-icon"></i>
            <span class="squire-build-slot-label">{{this.label}}</span>
            {{/if}}
        </div>
        {{/each}}
    </div>

    </div>

    {{#if isCaster}}
    {{!-- THE PREPARED COLUMN.

          Twenty-six cells, two across, down the side of the doll — and its size
          is not a choice. A cell is half a gear slot, so two of them stack into
          exactly one body row and the column keeps the doll's gridlines the
          whole way down; thirteen rows is what fits beside the body and the
          weapons under it.

          A caster's, and only a caster's. It briefly held carried potions for
          everybody else, which was the one thing in this window that applying
          could not enforce — there is no carried state in the system to set, so
          those cells looked exactly like the ones around them and did nothing.
          A martial's build is the doll, and their window is narrower by this
          column rather than padded out with it.

          Cells past the limit are dimmed and refuse drops: they are not empty,
          they are cells this character does not have YET, and drawing them is
          how the column says what levelling up will buy. --}}
    <div class="squire-build-pack">
        {{!-- The head of the column: exactly one body row tall, which is what
              drops the grid below it level with the top of the NECK slot rather
              than with the portrait circles above it. The spell slots live in
              that square, since it is the one place in the window they can go
              without pushing a cell out of true.

              A martial gets the same square holding nothing. It is not spare
              space, it is the offset — remove it and their column stops lining
              up with their doll. --}}
        <div class="squire-build-pack-head">
            {{#if spellSlots}}
            {{!-- The nine ranks as a three by three, reading left to right: 1st
                  in the corner, 9th in the far one. Position IS the label at
                  this size, and a grid of nine that never changes shape is
                  something you can read without counting. A rank the character
                  has not reached is dimmed and marked "--", the same statement
                  the dimmed cells below make.

                  A readout, never a drop target: in 5e you prepare a LIST and
                  cast any prepared spell with a slot of sufficient level, so
                  there is nothing to put in these. Once for the character, not
                  once per class, because a multiclass caster casts from one
                  pool. --}}
            <div class="squire-build-slot-ranks">
                {{#each spellSlots}}
                <span class="squire-build-rank{{#unless this.has}} is-empty{{/unless}}"
                      data-tooltip="{{#if this.has}}{{this.label}} level: {{this.value}} of {{this.max}} remaining{{else}}No {{this.label}} level slots yet{{/if}}">
                    {{#if this.has}}{{this.max}}{{else}}--{{/if}}
                </span>
                {{/each}}
            </div>
            {{/if}}
        </div>

        <div class="squire-build-pack-grid">
            {{#each pack}}
            <div class="squire-build-pack-cell{{#if this.beyond}} is-beyond{{/if}}{{#if this.filled}} is-filled{{/if}}{{#if this.missing}} is-missing{{/if}}"
                 data-pack-index="{{this.index}}"{{#if this.itemId}} data-item-id="{{this.itemId}}"{{/if}}
                 data-tooltip="{{#if this.beyond}}Not prepared at this level yet{{else if this.filled}}{{this.name}}<br><em>Right-click to clear</em>{{else if this.missing}}This is no longer on the sheet<br><em>Right-click to clear</em>{{else}}Drag something here{{/if}}">
                {{#if this.filled}}
                <img class="squire-build-slot-image" src="{{this.img}}" alt="{{this.name}}">
                {{#if this.concentration}}
                <i class="fa-solid fa-circle-c squire-build-concentration" data-tooltip="Concentration"></i>
                {{/if}}
                {{!-- The spell's level, in the corner a gear slot uses for its
                      glyph: both answer "what kind of thing is this". --}}
                {{#if this.level}}
                <span class="squire-build-pack-mark">{{this.level}}</span>
                {{/if}}
                {{else if this.missing}}
                <i class="fa-solid fa-triangle-exclamation squire-build-slot-icon is-warning"></i>
                {{else}}
                {{!-- The glyph marks an OPEN slot — it is the thing that makes
                      the available cells read as available at a glance, which a
                      row of empty boxes does not. Only on the cells that can
                      actually take a spell: on a dimmed one it would be an
                      invitation the character has not earned yet. --}}
                {{#unless this.beyond}}
                <i class="fa-solid fa-sparkles squire-build-slot-icon"></i>
                {{/unless}}
                {{!-- Numbered while empty and gone once filled. Until there is a
                      picture in it a cell has nothing to say for itself, and
                      "this is your eleventh of seventeen" is the context that
                      makes the column legible; afterwards the spell is the
                      label and the number is noise. --}}
                <span class="squire-build-pack-number">{{this.position}}</span>
                {{/if}}
            </div>
            {{/each}}
        </div>
    </div>
    {{/if}}
    {{/unless}}

    </div>
    {{else}}
    <div class="squire-empty-message squire-build-empty">
        <p>- No Builds Yet -</p>
        <p>Use New Build to start one</p>
    </div>
    {{/if}}

    </div>
</div>
