{{#if ownedCharacters}}
<div class="character-switcher">
    {{#each ownedCharacters}}
    {{#if divider}}<div class="character-switcher-divider"></div>{{/if}}
    <div class="character-switcher-chip{{#if active}} active{{/if}}{{#unless onScene}} off-scene{{/unless}}" data-actor-id="{{id}}" title="{{name}}{{#unless onScene}} (not on this scene){{/unless}}">
        <img src="{{img}}" alt="{{name}}">
    </div>
    {{/each}}
</div>
{{/if}}
<div class="character-panel">
    <!-- HEADER -->
    <div class="header-left">
        <div class="character-portrait clickable" title="Click to share portrait with all players">
            <img src="{{actor.img}}" alt="{{default displayName actor.name}}" title="{{default displayName actor.name}}">
            <div class="health-overlay" style="height: {{healthOverlayHeight actor.system.attributes.hp}}"></div>
            {{#if (eq actor.system.attributes.hp.value 0)}}<i class="fa-solid fa-skull death-skull"></i>{{/if}}
        </div>
        <div class="character-info">
            <span class="character-name">{{default displayName actor.name}}</span>
            <div class="character-details">
                <div class="details-primary">
                    {{#if (eq actor.type "character")}}
                        {{#each actor.items as |item|}}
                            {{#if (eq item.type "class")}}
                                {{item.name}} • Level {{item.system.levels}}
                            {{/if}}
                        {{/each}}
                    {{else}}
                        {{#if actor.system.details.cr}}CR {{actor.system.details.cr}}{{/if}}
                    {{/if}}
                    {{#if actor.system.details.alignment}} • {{actor.system.details.alignment}}{{/if}}
                    {{!-- Disposition, and NOT the same thing as the alignment above
                          it: alignment is what the character believes, disposition
                          is how this token behaves toward the party. An NPC can be
                          Lawful Good and hostile.

                          Same rule as the party card — always for a non-character
                          actor, and for a player character only when it is not
                          friendly. Labelling every ally FRIENDLY labels the default,
                          which makes the rare case harder to spot rather than
                          easier. --}}
                    {{#if disposition}}
                    {{#if (or (ne actor.type "character") (ne disposition.key "friendly"))}}
                    <span class="squire-disposition disposition-{{disposition.key}}">{{disposition.label}}</span>
                    {{/if}}
                    {{/if}}
                </div>
                <div class="details-secondary">
                    {{#if speeds}}
                        <div>SPEED: {{#each speeds}}{{#unless @first}}, {{/unless}}{{#unless hideLabel}}{{label}} {{/unless}}{{value}}{{#if ../speedUnits}} {{../speedUnits}}{{/if}}{{#if (and (eq type "fly") ../canHover)}} (hover){{/if}}{{/each}}</div>
                    {{/if}}
                </div>
            </div>
        </div>
    </div>
    <div class="header-right">
        <i class="fa-solid fa-scroll print-character" title="Print Character Sheet"></i>
        <i class="fa-solid fa-feather character-sheet-toggle" title="Open Character Sheet"></i>
    </div>
</div> 



