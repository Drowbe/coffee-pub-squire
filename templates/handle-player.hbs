{{#if actor}}

    {{!-- CHARACTER NAME --}} 
    <div class="handle-info-container">
        <span class="handle-info-title">{{default actorDisplayName actor.name}}</span>
    </div>

    <span class="tray-handle-separator spacer"></span>

    {{!-- PLAYER --}} 
    <div class="handle-partymembers">
        {{!-- CHARACTER PORTRAIT --}} 
        {{> handle-character-portrait actor=actor displayName=(default actorDisplayName actor.handleDisplayName)}} 
        {{!-- PLAYER HEALTH --}} 
         {{#if showHandleHealthBar}}
            {{> handle-health id="player"}}
        {{/if}}
    </div>
    <span class="tray-handle-separator line-ridge-thin"></span>

    {{!-- FAVORITES --}} 
    {{#if showHandleFavorites}}
        {{#if (getHandleFavorites actor)}}
            {{> handle-favorites}}
            <span class="tray-handle-separator line-ridge-thin"></span>
        {{/if}}
    {{/if}}

    {{!-- CONDITIONS --}}
    {{#if showHandleConditions}}
        {{> handle-conditions}}
        <span class="tray-handle-separator line-ridge-thin"></span>
    {{/if}}

{{else}}
    {{!-- NO CHARACTER SELECTED --}} 
    <div class="handle-info-container">
        <span class="handle-info-title">Select or Create a Character</span>
    </div>
    <span class="tray-handle-separator spacer"></span>
{{/if}}

{{!-- Macros and the Dice Tray are reached from the Blacksmith menubar rather
      than the handle: the handle is a narrow strip whose value is showing THIS
      token's state, and both of those are global tools that ignore selection. --}}
