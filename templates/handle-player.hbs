{{!-- CHARACTER HANDLE

      Written top to bottom, in the order it appears on screen.

      It used to be written bottom-up and flipped by `transform: rotate(180deg)`
      on the content wrapper, so this file read name → portrait → favourites →
      conditions and the screen showed the exact reverse. The rotation is gone;
      what is written first is what appears at the top.

      The groups are ordered by how often a thing changes and how much you care
      when it does: HP first, then conditions, then favourites — which are the
      only group here you go looking for rather than monitor. --}}

{{#if actor}}

    {{!-- WHO THIS IS, AND HOW THEY ARE DOING --}}
    <div class="handle-group handle-identity">
        {{> handle-character-portrait actor=actor displayName=(default actorDisplayName actor.handleDisplayName)}}
        {{#if showHandleHealthBar}}
            {{> handle-health id="player"}}
        {{/if}}
    </div>

    {{!-- CONDITIONS — two to a row. These are the thing most likely to overflow
          and the thing you most need to see ALL of, so they get the smallest
          box and the densest packing. --}}
    {{#if showHandleConditions}}
        {{> handle-conditions}}
    {{/if}}

    {{!-- FAVOURITES --}}
    {{#if showHandleFavorites}}
        {{#if (getHandleFavorites actor)}}
            {{> handle-favorites}}
        {{/if}}
    {{/if}}

{{else}}
    {{!-- NO CHARACTER. An icon, not a rotated sentence: the empty state used to
          spend the tallest element on the strip saying something the tray itself
          says in full the moment you open it. --}}
    <div class="handle-group handle-empty" data-tooltip="Select or create a character">
        <i class="fa-solid fa-user-slash"></i>
    </div>
{{/if}}

{{!-- Macros and the Dice Tray are reached from the Blacksmith menubar rather
      than the handle: the handle is a status column for THIS token, and both of
      those are global tools that ignore selection. --}}
